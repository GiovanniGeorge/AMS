@* Registers an asset from the invoice that is billing it.

   Not built on QuickAdd: an asset is not a lookup row. Its number comes from the
   category prefix through AssetService, and it needs a condition, so it goes through
   the same RegisterAsync every asset goes through. Purchase cost, date and supplier
   are left empty here on purpose - the invoice fills them in when it is saved. *@


<span class="ams-quickadd">
    @if (!_open)
    {
        <button type="button" class="ams-btn link" @onclick="Open" title="Register an asset without leaving this invoice">
            + New asset
        </button>
    }
    else
    {
        <div class="ams-quickadd-box">
            <input placeholder="asset name" @bind="_name" @bind:event="oninput" />

            <select @bind="_categoryId" @bind:after="PreviewAsync">
                <option value="">— category —</option>
                @foreach (var c in _categories)
                {
                    <option value="@c.Id">@c.Name</option>
                }
            </select>

            <select @bind="_statusId">
                <option value="">— condition —</option>
                @foreach (var s in _statuses)
                {
                    <option value="@s.Id">@s.Name</option>
                }
            </select>

            @if (_preview is not null)
            {
                <div class="ams-hint">Number: @_preview</div>
            }

            @if (_error is not null)
            {
                <div class="ams-alert small">@_error</div>
            }

            <div class="ams-quickadd-actions">
                <button type="button" class="ams-btn" @onclick="SaveAsync" disabled="@_saving">Add</button>
                <button type="button" class="ams-btn ghost" @onclick="Cancel">Cancel</button>
            </div>
        </div>
    }
</span>
