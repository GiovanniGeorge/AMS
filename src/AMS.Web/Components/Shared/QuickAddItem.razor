@* A store item is always counted in something, so the quick-add asks for the unit too. *@


<QuickAdd TItem="Item" What="item" OnAdded="AddedAsync"
          Prepare="Fill" Validate="Check">
    <Extra>
        <select @bind="_unitId">
            <option value="">— unit of measure —</option>
            @foreach (var u in _units)
            {
                <option value="@u.Id">@u.Name</option>
            }
        </select>
    </Extra>
</QuickAdd>
