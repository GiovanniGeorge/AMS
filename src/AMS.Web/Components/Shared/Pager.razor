@* Previous / next for any list that returns Paged<T>. Hides itself when there is one page. *@

@if (Pages > 1)
{
    <div class="ams-toolbar" style="justify-content:space-between;">
        <button class="ams-btn ghost" @onclick="PreviousAsync" disabled="@(Page <= 1)">&larr; Previous</button>
        <span class="ams-muted">Page @Page of @Pages · @Total row(s)</span>
        <button class="ams-btn ghost" @onclick="NextAsync" disabled="@(Page >= Pages)">Next &rarr;</button>
    </div>
}
