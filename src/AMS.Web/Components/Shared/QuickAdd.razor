@* Adds a missing lookup row without leaving the screen you are on.

   The point is that a half-finished purchase order should never have to be
   abandoned because a supplier is not in the list yet. Press +, type the name,
   press Add: the row is created and handed back so the caller can select it.

   Only for lookups whose whole identity is a name. A table with required fields
   of its own (Category needs its numbering prefix, useful life and salvage value)
   passes them through Extra / Prepare, or is left to its own screen. *@

@typeparam TItem where TItem : BaseEntity, INamedEntity, new()

<span class="ams-quickadd">
    @if (!_open)
    {
        <button type="button" class="ams-btn link" @onclick="Open" title="@($"Add a {What} without leaving this form")">
            + New @What
        </button>
    }
    else
    {
        <div class="ams-quickadd-box">
            <input placeholder="@($"{What} name")" @bind="_name" @bind:event="oninput" />
            @Extra
            @if (_error is not null)
            {
                <div class="ams-alert small">@_error</div>
            }
            <div class="ams-quickadd-actions">
                <button type="button" class="ams-btn" @onclick="SaveAsync" disabled="@_saving">Add</button>
                <button type="button" class="ams-btn ghost" @onclick="Cancel">Cancel</button>
            </div>
        </div>
    }
</span>
