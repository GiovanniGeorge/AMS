@* Adds a missing lookup row without leaving the screen you are on.

   The point is that a half-finished purchase order should never have to be
   abandoned because a supplier is not in the list yet. Press +, type the name,
   press Add: the row is created and handed back so the caller can select it.

   Only for lookups whose whole identity is a name. A table with required fields
   of its own (Category needs its numbering prefix, useful life and salvage value)
   passes them through Extra / Prepare, or is left to its own screen. *@

@typeparam TItem where TItem : BaseEntity, INamedEntity, new()
@inject ICrudService<TItem> Service

<span class="ams-quickadd">
    @if (!_open)
    {
        <button type="button" class="ams-btn link" @onclick="Open" title="@($"Add a {What} without leaving this form")">
            + New @What
        </button>
    }
    else
    {
        <div class="ams-quickadd-box">
            <input placeholder="@($"{What} name")" @bind="_name" @bind:event="oninput" />
            @Extra
            @if (_error is not null)
            {
                <div class="ams-alert small">@_error</div>
            }
            <div class="ams-quickadd-actions">
                <button type="button" class="ams-btn" @onclick="SaveAsync" disabled="@_saving">Add</button>
                <button type="button" class="ams-btn ghost" @onclick="Cancel">Cancel</button>
            </div>
        </div>
    }
</span>

@code {
    /// <summary>What is being added, in lower case: "supplier", "location", "item".</summary>
    [Parameter] public string What { get; set; } = "record";

    /// <summary>Extra inputs this lookup needs — an item's unit of measure, for example.</summary>
    [Parameter] public RenderFragment? Extra { get; set; }

    /// <summary>Fills whatever Extra collected onto the new row, just before it is saved.</summary>
    [Parameter] public Action<TItem>? Prepare { get; set; }

    /// <summary>Validates what Extra collected; return a message to stop the save.</summary>
    [Parameter] public Func<string?>? Validate { get; set; }

    /// <summary>The saved row, so the caller can refresh its list and select it.</summary>
    [Parameter] public EventCallback<TItem> OnAdded { get; set; }

    private bool _open;
    private bool _saving;
    private string? _name;
    private string? _error;

    private void Open()
    {
        _open = true;
        _name = null;
        _error = null;
    }

    private void Cancel()
    {
        _open = false;
        _error = null;
    }

    private async Task SaveAsync()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_name))
        {
            _error = $"Type the {What} name.";
            return;
        }

        if (Validate?.Invoke() is { } problem)
        {
            _error = problem;
            return;
        }

        _saving = true;

        try
        {
            var created = new TItem { Name = _name!.Trim() };
            Prepare?.Invoke(created);

            await Service.AddAsync(created);

            _open = false;
            await OnAdded.InvokeAsync(created);
        }
        catch (Exception ex)
        {
            _error = ex.InnerException?.Message ?? ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }
}
