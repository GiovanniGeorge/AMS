@* A category is not just a name: its prefix numbers every asset filed under it, and its
   useful life and salvage value are what depreciation is calculated from. Creating one
   without them would quietly produce assets that cannot be numbered or depreciated, so
   the quick-add asks for them here rather than leaving a half-made row behind. *@

<QuickAdd TItem="Category" What="category" OnAdded="AddedAsync"
          Prepare="Fill" Validate="Check">
    <Extra>
        <input placeholder="numbering prefix, e.g. LAP" @bind="_prefix" @bind:event="oninput" />
        <input type="number" step="0.5" placeholder="useful life in years" @bind="_usefulLife" />
        <input type="number" step="0.01" placeholder="salvage value" @bind="_salvageValue" />
    </Extra>
</QuickAdd>

@code {
    [Parameter] public EventCallback<Category> OnAdded { get; set; }

    private string? _prefix;
    private decimal? _usefulLife;
    private decimal? _salvageValue;

    private string? Check()
    {
        if (_usefulLife is <= 0)
        {
            return "The useful life must be greater than zero, or left empty.";
        }

        if (_salvageValue is < 0)
        {
            return "The salvage value cannot be negative.";
        }

        return null;
    }

    private void Fill(Category category)
    {
        // All three are optional: a category with no prefix simply means the asset
        // number is typed by hand, and with no useful life it is not depreciated.
        category.NumberingPrefix = string.IsNullOrWhiteSpace(_prefix) ? null : _prefix.Trim();
        category.UsefulLife = _usefulLife;
        category.SalvageValue = _salvageValue;
    }

    private async Task AddedAsync(Category category)
    {
        _prefix = null;
        _usefulLife = null;
        _salvageValue = null;
        await OnAdded.InvokeAsync(category);
    }
}
