@page "/invoices"
@inject ICrudService<Invoice> Invoices
@inject ICrudService<Supplier> Suppliers
@inject IPurchaseOrderService Orders
@inject ICrudService<User> Users

<PageTitle>Invoices</PageTitle>

<div class="ams-page-head">
    <div>
        <h1>Invoices</h1>
        <div class="sub">@_total invoice(s)</div>
    </div>
    <button class="ams-btn" @onclick="OpenNew">+ New Invoice</button>
</div>

@if (_error is not null)
{
    <div class="ams-alert">@_error</div>
}

<div class="ams-card">
    <div class="ams-toolbar ams-filters">
        <label><input type="checkbox" @bind="_showInactive" @bind:after="FilterAsync" /> Show inactive</label>
    </div>

    @if (_rows is null)
    {
        <div class="ams-empty">Loading&hellip;</div>
    }
    else if (_rows.Count == 0)
    {
        <div class="ams-empty">No invoices.</div>
    }
    else
    {
        <table class="ams-table">
            <thead>
                <tr>
                    <th>Number</th><th>Supplier</th><th>Purchase order</th><th>Date</th>
                    <th>Amount</th><th>Created by</th><th>Status</th><th class="actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var i in _rows)
                {
                    <tr class="@(i.IsActive ? "" : "is-inactive")">
                        <td>@i.InvoiceNumber</td>
                        <td>@(i.Supplier?.Name ?? "—")</td>
                        <td>@(i.PurchaseOrder?.PurchaseOrderNumber ?? "—")</td>
                        <td>@i.InvoiceDate?.ToString("yyyy-MM-dd")</td>
                        <td>@(i.Amount?.ToString("N2") ?? "—") @i.Currency</td>
                        <td><UserName Id="i.CreatedById" Names="_userNames" /></td>
                        <td><StatusBadge Active="i.IsActive" /></td>
                        <td class="actions">
                            <button class="ams-btn link" @onclick="() => OpenEdit(i)">Edit</button>
                            <button class="ams-btn link @(i.IsActive ? "danger" : "")" @onclick="() => ToggleAsync(i)">
                                @(i.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <Pager Page="_page" Total="_total" PageChanged="GoToAsync" />
    }
</div>

<ModalForm Visible="_open" Title="@(_editId is null ? "New invoice" : "Edit invoice")" OnSave="SaveAsync" OnCancel="Close">
    <div class="ams-grid">
        <div class="ams-field">
            <label>Invoice number *</label>
            <input @bind="_number" />
        </div>

        <div class="ams-field">
            <label>Supplier</label>
            <select @bind="_supplierId">
                <option value="">— none —</option>
                @foreach (var s in _suppliers)
                {
                    <option value="@s.Id">@s.Name</option>
                }
            </select>
        </div>

        <div class="ams-field">
            <label>Purchase order</label>
            <select @bind="_purchaseOrderId">
                <option value="">— none —</option>
                @foreach (var o in _orders)
                {
                    <option value="@o.Id">@o.PurchaseOrderNumber</option>
                }
            </select>
        </div>

        <div class="ams-field">
            <label>Invoice date</label>
            <input type="date" @bind="_date" />
        </div>

        <div class="ams-field">
            <label>Amount</label>
            <input type="number" step="0.01" @bind="_amount" />
        </div>

        <div class="ams-field">
            <label>Currency</label>
            <input @bind="_currency" />
        </div>
    </div>

    <p class="ams-hint">The same invoice number can only be used once per supplier.</p>
</ModalForm>

@code {
    private List<Invoice>? _rows;
    private List<Supplier> _suppliers = new();
    private List<PurchaseOrder> _orders = new();
    private Dictionary<int, string> _userNames = new();
    private bool _showInactive;
    private int _total;
    private int _page = 1;


    private bool _open;
    private int? _editId;
    private string? _number;
    private int? _supplierId;
    private int? _purchaseOrderId;
    private DateTime? _date = DateTime.Today;
    private decimal? _amount;
    private string? _currency;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _suppliers = await Suppliers.GetAllAsync(true);
            _orders = await Orders.GetOpenAsync();
            _userNames = (await Users.GetAllAsync(true)).ToDictionary(u => u.Id, u => u.Username);
        }
        catch (Exception ex) { _error = ex.Message; }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            var result = await Invoices.GetPageAsync(_page, _showInactive, i => i.Supplier!, i => i.PurchaseOrder!);
            _rows = result.Items;
            _total = result.Total;
            _error = null;
        }
        catch (Exception ex) { _error = ex.Message; }
    }


    private async Task GoToAsync(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private async Task FilterAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    private void OpenNew()
    {
        _editId = null;
        _number = null;
        _supplierId = null;
        _purchaseOrderId = null;
        _date = DateTime.Today;
        _amount = null;
        _currency = null;
        _error = null;
        _open = true;
    }

    private void OpenEdit(Invoice invoice)
    {
        // A closed order is not in the drop-down, so put this invoice's own order back in it.
        if (invoice.PurchaseOrder is not null && _orders.All(o => o.Id != invoice.PurchaseOrderId))
        {
            _orders = _orders.Append(invoice.PurchaseOrder).ToList();
        }

        _editId = invoice.Id;
        _number = invoice.InvoiceNumber;
        _supplierId = invoice.SupplierId;
        _purchaseOrderId = invoice.PurchaseOrderId;
        _date = invoice.InvoiceDate;
        _amount = invoice.Amount;
        _currency = invoice.Currency;
        _error = null;
        _open = true;
    }

    private void Close() => _open = false;

    private async Task SaveAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_number)) { _error = "The invoice number is required."; return; }

        // The database enforces one invoice number per supplier; say it in plain words
        // instead of letting the SQL Server message through.
        var clash = (await Invoices.GetAllAsync(true)).Any(i =>
            i.Id != _editId
            && i.SupplierId == _supplierId
            && string.Equals(i.InvoiceNumber, _number!.Trim(), StringComparison.OrdinalIgnoreCase));

        if (clash && _supplierId is not null)
        {
            _error = "This supplier already has an invoice with that number.";
            return;
        }

        try
        {
            if (_editId is int id)
            {
                var existing = await Invoices.GetByIdAsync(id);
                if (existing is null) { _error = "Invoice not found."; return; }

                existing.InvoiceNumber = _number!.Trim();
                existing.SupplierId = _supplierId;
                existing.PurchaseOrderId = _purchaseOrderId;
                existing.InvoiceDate = _date;
                existing.Amount = _amount;
                existing.Currency = _currency;

                await Invoices.UpdateAsync(existing);
            }
            else
            {
                await Invoices.AddAsync(new Invoice
                {
                    InvoiceNumber = _number!.Trim(),
                    SupplierId = _supplierId,
                    PurchaseOrderId = _purchaseOrderId,
                    InvoiceDate = _date,
                    Amount = _amount,
                    Currency = _currency
                });
            }

            _open = false;
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.InnerException?.Message ?? ex.Message; }
    }

    private async Task ToggleAsync(Invoice invoice)
    {
        if (invoice.IsActive) await Invoices.DeactivateAsync(invoice.Id);
        else await Invoices.ActivateAsync(invoice.Id);
        await LoadAsync();
    }
}
