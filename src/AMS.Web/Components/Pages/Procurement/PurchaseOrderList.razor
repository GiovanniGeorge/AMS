@page "/purchase-orders"

<PageTitle>Purchase Orders</PageTitle>

<div class="ams-page-head">
    <div>
        <h1>Purchase Orders</h1>
        <div class="sub">@_total order(s) — the total is always the sum of the lines</div>
    </div>
    <button class="ams-btn" @onclick="OpenNewAsync">+ Purchase Order</button>
</div>

@if (_pageError is not null)
{
    <div class="ams-alert">@_pageError</div>
}

<div class="ams-card">
    <div class="ams-toolbar ams-filters">
        <select @bind="_status" @bind:after="FilterAsync">
            <option value="">All statuses</option>
            <option value="@PurchaseOrderStatus.Open">Open</option>
            <option value="@PurchaseOrderStatus.Closed">Closed</option>
        </select>
    </div>

    @if (_rows is null)
    {
        <div class="ams-empty">Loading&hellip;</div>
    }
    else if (_rows.Count == 0)
    {
        <div class="ams-empty">No purchase orders.</div>
    }
    else
    {
        <table class="ams-table">
            <thead>
                <tr>
                    <th>Number</th><th>Supplier</th><th>Date</th><th>Expected</th><th>Lines</th>
                    <th>Total</th><th>Status</th><th>Created by</th><th class="actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in _rows)
                {
                    <tr>
                        <td>@p.PurchaseOrderNumber</td>
                        <td>@(p.Supplier?.Name ?? "—")</td>
                        <td>@p.PurchaseDate?.ToString("yyyy-MM-dd")</td>
                        <td>@p.ExpectedDeliveryDate?.ToString("yyyy-MM-dd")</td>
                        <td>
                            @if (p.Lines.Count == 0)
                            {
                                <span class="ams-muted">no lines yet</span>
                            }
                            else
                            {
                                @foreach (var l in p.Lines)
                                {
                                    <div>@(l.Item?.Name ?? l.Description) &times; @l.Quantity.ToString("N2") @(l.UnitPrice is null ? "" : "@ " + l.UnitPrice.Value.ToString("N2"))</div>
                                }
                            }
                        </td>
                        <td>@(p.TotalCost?.ToString("N2") ?? "—") @p.Currency</td>
                        <td>@p.Status</td>
                        <td><UserName Id="p.CreatedById" Names="_userNames" /></td>
                        <td class="actions">
                            @if (p.Status != PurchaseOrderStatus.Closed)
                            {
                                <button class="ams-btn link" @onclick="() => OpenEdit(p)">Edit</button>
                                <button class="ams-btn link" @onclick="() => CloseOrderAsync(p.Id)">Close</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <Pager Page="_page" Total="_total" PageChanged="GoToAsync" />
    }
</div>

<ModalForm Visible="_open"
           Title="@(_editId is null ? "New purchase order" : "Edit purchase order " + _number)"
           Error="@_error"
           OnSave="SaveAsync"
           OnCancel="Close">
    <div class="ams-grid">
        <div class="ams-field">
            <label>Number</label>
            <div class="ams-readonly">@_number @(_editId is null ? "(generated on save)" : "")</div>
        </div>

        <div class="ams-field">
            <label>Supplier</label>
            <select @bind="_supplierId">
                <option value="">— none —</option>
                @foreach (var s in _suppliers)
                {
                    <option value="@s.Id">@s.Name</option>
                }
            </select>
            <QuickAdd TItem="Supplier" What="supplier" OnAdded="SupplierAddedAsync" />
        </div>

        <div class="ams-field">
            <label>Order date</label>
            <input type="date" @bind="_date" />
        </div>

        <div class="ams-field">
            <label>Expected delivery</label>
            <input type="date" @bind="_expected" />
        </div>

        <div class="ams-field">
            <label>Currency</label>
            <select @bind="_currency">
                @foreach (var c in Currencies.All)
                {
                    <option value="@c">@c</option>
                }
            </select>
        </div>

        <div class="ams-field">
            <label>Total</label>
            <div class="ams-readonly">@Total.ToString("N2") @_currency</div>
        </div>
    </div>

    <h3 style="margin-top:14px;">Lines (@_lines.Count)</h3>

    @if (_lines.Count > 0)
    {
        <table class="ams-table">
            <thead><tr><th>Item / description</th><th>Quantity</th><th>Unit price</th><th>Line total</th><th class="actions"></th></tr></thead>
            <tbody>
                @foreach (var l in _lines)
                {
                    <tr>
                        <td>@(_items.FirstOrDefault(i => i.Id == l.ItemId)?.Name ?? l.Description)</td>
                        <td>@l.Quantity.ToString("N2")</td>
                        <td>@(l.UnitPrice?.ToString("N2") ?? "—")</td>
                        <td>@((l.Quantity * (l.UnitPrice ?? 0m)).ToString("N2"))</td>
                        <td class="actions"><button class="ams-btn link danger" @onclick="() => _lines.Remove(l)">Remove</button></td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="ams-grid" style="margin-top:8px;">
        <div class="ams-field">
            <label>Item</label>
            <select @bind="_lineItemId">
                <option value="">— free text —</option>
                @foreach (var i in _items)
                {
                    <option value="@i.Id">@i.Name</option>
                }
            </select>
            <QuickAddItem OnAdded="ItemAddedAsync" />
        </div>

        <div class="ams-field">
            <label>Description</label>
            <input @bind="_lineDescription" placeholder="Used when no item is chosen" />
        </div>

        <div class="ams-field">
            <label>Quantity</label>
            <input type="number" step="0.01" @bind="_lineQuantity" />
        </div>

        <div class="ams-field">
            <label>Unit price</label>
            <input type="number" step="0.01" @bind="_lineUnitPrice" />
        </div>

        <div class="ams-field">
            <label>&nbsp;</label>
            <button class="ams-btn ghost" @onclick="AddLine">+ Add line</button>
        </div>
    </div>

    <p class="ams-hint">
        An order can be saved with no lines at all and filled in later. If you have typed a line
        here and press Save without pressing "+ Add line", it is added for you — nothing is lost.
    </p>
</ModalForm>
