@page "/purchase-orders"
@inject IPurchaseOrderService Orders
@inject ICrudService<Supplier> Suppliers
@inject ICrudService<Item> Items
@inject ICrudService<Unit> Units
@inject ICrudService<User> Users

<PageTitle>Purchase Orders</PageTitle>

<div class="ams-page-head">
    <div>
        <h1>Purchase Orders</h1>
        <div class="sub">@_total order(s) — the total is always the sum of the lines</div>
    </div>
    <button class="ams-btn" @onclick="OpenNewAsync">+ Purchase Order</button>
</div>

@if (_pageError is not null)
{
    <div class="ams-alert">@_pageError</div>
}

<div class="ams-card">
    <div class="ams-toolbar ams-filters">
        <select @bind="_status" @bind:after="FilterAsync">
            <option value="">All statuses</option>
            <option value="@PurchaseOrderStatus.Open">Open</option>
            <option value="@PurchaseOrderStatus.Closed">Closed</option>
        </select>
    </div>

    @if (_rows is null)
    {
        <div class="ams-empty">Loading&hellip;</div>
    }
    else if (_rows.Count == 0)
    {
        <div class="ams-empty">No purchase orders.</div>
    }
    else
    {
        <table class="ams-table">
            <thead>
                <tr>
                    <th>Number</th><th>Supplier</th><th>Date</th><th>Expected</th><th>Lines</th>
                    <th>Total</th><th>Status</th><th>Created by</th><th class="actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in _rows)
                {
                    <tr>
                        <td>@p.PurchaseOrderNumber</td>
                        <td>@(p.Supplier?.Name ?? "—")</td>
                        <td>@p.PurchaseDate?.ToString("yyyy-MM-dd")</td>
                        <td>@p.ExpectedDeliveryDate?.ToString("yyyy-MM-dd")</td>
                        <td>
                            @if (p.Lines.Count == 0)
                            {
                                <span class="ams-muted">no lines yet</span>
                            }
                            else
                            {
                                @foreach (var l in p.Lines)
                                {
                                    <div>@(l.Item?.Name ?? l.Description) &times; @l.Quantity.ToString("N2") @(l.UnitPrice is null ? "" : "@ " + l.UnitPrice.Value.ToString("N2"))</div>
                                }
                            }
                        </td>
                        <td>@(p.TotalCost?.ToString("N2") ?? "—") @p.Currency</td>
                        <td>@p.Status</td>
                        <td><UserName Id="p.CreatedById" Names="_userNames" /></td>
                        <td class="actions">
                            @if (p.Status != PurchaseOrderStatus.Closed)
                            {
                                <button class="ams-btn link" @onclick="() => OpenEdit(p)">Edit</button>
                                <button class="ams-btn link" @onclick="() => CloseOrderAsync(p.Id)">Close</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <Pager Page="_page" Total="_total" PageChanged="GoToAsync" />
    }
</div>

<ModalForm Visible="_open"
           Title="@(_editId is null ? "New purchase order" : "Edit purchase order " + _number)"
           Error="@_error"
           OnSave="SaveAsync"
           OnCancel="Close">
    <div class="ams-grid">
        <div class="ams-field">
            <label>Number</label>
            <div class="ams-readonly">@_number @(_editId is null ? "(generated on save)" : "")</div>
        </div>

        <div class="ams-field">
            <label>Supplier</label>
            <select @bind="_supplierId">
                <option value="">— none —</option>
                @foreach (var s in _suppliers)
                {
                    <option value="@s.Id">@s.Name</option>
                }
            </select>
            <QuickAdd TItem="Supplier" What="supplier" OnAdded="SupplierAddedAsync" />
        </div>

        <div class="ams-field">
            <label>Order date</label>
            <input type="date" @bind="_date" />
        </div>

        <div class="ams-field">
            <label>Expected delivery</label>
            <input type="date" @bind="_expected" />
        </div>

        <div class="ams-field">
            <label>Currency</label>
            <select @bind="_currency">
                @foreach (var c in Currencies.All)
                {
                    <option value="@c">@c</option>
                }
            </select>
        </div>

        <div class="ams-field">
            <label>Total</label>
            <div class="ams-readonly">@Total.ToString("N2") @_currency</div>
        </div>
    </div>

    <h3 style="margin-top:14px;">Lines (@_lines.Count)</h3>

    @if (_lines.Count > 0)
    {
        <table class="ams-table">
            <thead><tr><th>Item / description</th><th>Quantity</th><th>Unit price</th><th>Line total</th><th class="actions"></th></tr></thead>
            <tbody>
                @foreach (var l in _lines)
                {
                    <tr>
                        <td>@(_items.FirstOrDefault(i => i.Id == l.ItemId)?.Name ?? l.Description)</td>
                        <td>@l.Quantity.ToString("N2")</td>
                        <td>@(l.UnitPrice?.ToString("N2") ?? "—")</td>
                        <td>@((l.Quantity * (l.UnitPrice ?? 0m)).ToString("N2"))</td>
                        <td class="actions"><button class="ams-btn link danger" @onclick="() => _lines.Remove(l)">Remove</button></td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="ams-grid" style="margin-top:8px;">
        <div class="ams-field">
            <label>Item</label>
            <select @bind="_lineItemId">
                <option value="">— free text —</option>
                @foreach (var i in _items)
                {
                    <option value="@i.Id">@i.Name</option>
                }
            </select>
            <QuickAdd TItem="Item" What="item" OnAdded="ItemAddedAsync"
                      Prepare="i => i.UnitOfMeasureId = _quickUnitId ?? 0"
                      Validate="ValidateQuickItem">
                <Extra>
                    <select @bind="_quickUnitId">
                        <option value="">— unit of measure —</option>
                        @foreach (var u in _units)
                        {
                            <option value="@u.Id">@u.Name</option>
                        }
                    </select>
                </Extra>
            </QuickAdd>
        </div>

        <div class="ams-field">
            <label>Description</label>
            <input @bind="_lineDescription" placeholder="Used when no item is chosen" />
        </div>

        <div class="ams-field">
            <label>Quantity</label>
            <input type="number" step="0.01" @bind="_lineQuantity" />
        </div>

        <div class="ams-field">
            <label>Unit price</label>
            <input type="number" step="0.01" @bind="_lineUnitPrice" />
        </div>

        <div class="ams-field">
            <label>&nbsp;</label>
            <button class="ams-btn ghost" @onclick="AddLine">+ Add line</button>
        </div>
    </div>

    <p class="ams-hint">
        An order can be saved with no lines at all and filled in later. If you have typed a line
        here and press Save without pressing "+ Add line", it is added for you — nothing is lost.
    </p>
</ModalForm>

@code {
    private List<PurchaseOrder>? _rows;
    private List<Supplier> _suppliers = new();
    private List<Item> _items = new();
    private List<Unit> _units = new();
    private Dictionary<int, string> _userNames = new();
    private string _status = string.Empty;
    private int _total;
    private int _page = 1;

    private bool _open;
    private int? _editId;
    private string? _number;
    private int? _supplierId;
    private DateTime? _date = DateTime.Today;
    private DateTime? _expected;
    private string _currency = Currencies.Default;
    private List<PurchaseOrderLineInput> _lines = new();

    private int? _lineItemId;
    private string? _lineDescription;
    private decimal _lineQuantity = 1;
    private decimal? _lineUnitPrice;

    /// <summary>Unit chosen inside the item quick-add.</summary>
    private int? _quickUnitId;

    /// <summary>An item is counted in something, so the quick-add asks for it too.</summary>
    private string? ValidateQuickItem() =>
        _quickUnitId is null ? "Choose the unit this item is counted in." : null;

    /// <summary>Shown inside the dialog.</summary>
    private string? _error;

    /// <summary>Shown on the page itself, for failures that happen with the dialog closed.</summary>
    private string? _pageError;

    private decimal Total => _lines.Sum(l => l.Quantity * (l.UnitPrice ?? 0m));

    /// <summary>True when the line boxes hold something worth keeping.</summary>
    private bool HasTypedLine =>
        _lineItemId is not null || !string.IsNullOrWhiteSpace(_lineDescription);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _suppliers = await Suppliers.GetAllAsync();
            _items = await Items.GetAllAsync();
            _units = await Units.GetAllAsync();
            _userNames = (await Users.GetAllAsync(true)).ToDictionary(u => u.Id, u => u.Username);
        }
        catch (Exception ex) { _pageError = ex.Message; }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            var result = await Orders.GetAllAsync(string.IsNullOrEmpty(_status) ? null : _status, _page);
            _rows = result.Items;
            _total = result.Total;
            _pageError = null;
        }
        catch (Exception ex) { _pageError = ex.Message; }
    }

    private async Task GoToAsync(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private async Task FilterAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    // ------------------------------------------------------------------
    // Quick-add callbacks
    // ------------------------------------------------------------------

    private async Task SupplierAddedAsync(Supplier supplier)
    {
        _suppliers = await Suppliers.GetAllAsync();
        _supplierId = supplier.Id;
    }

    private async Task ItemAddedAsync(Item item)
    {
        _items = await Items.GetAllAsync();
        _lineItemId = item.Id;
        _quickUnitId = null;
    }

    // ------------------------------------------------------------------
    // The dialog
    // ------------------------------------------------------------------

    private async Task OpenNewAsync()
    {
        _editId = null;
        _supplierId = null;
        _date = DateTime.Today;
        _expected = null;
        _currency = Currencies.Default;
        _lines = new();
        ClearLine();
        _error = null;
        _open = true;

        try
        {
            _number = await Orders.PreviewNextNumberAsync();
        }
        catch (Exception ex)
        {
            _number = "—";
            _error = ex.Message;
        }
    }

    private void OpenEdit(PurchaseOrder order)
    {
        _editId = order.Id;
        _number = order.PurchaseOrderNumber;
        _supplierId = order.SupplierId;
        _date = order.PurchaseDate;
        _expected = order.ExpectedDeliveryDate;
        _currency = Currencies.Normalise(order.Currency);
        _lines = order.Lines
            .Select(l => new PurchaseOrderLineInput(l.ItemId, l.Description, l.Quantity, l.UnitPrice))
            .ToList();
        ClearLine();
        _error = null;
        _open = true;
    }

    private void Close() => _open = false;

    private void ClearLine()
    {
        _lineItemId = null;
        _lineDescription = null;
        _lineQuantity = 1;
        _lineUnitPrice = null;
        _quickUnitId = null;
    }

    /// <summary>Moves what is in the line boxes into the list. Returns false and sets the error if it cannot.</summary>
    private bool TakeTypedLine()
    {
        if (_lineItemId is null && string.IsNullOrWhiteSpace(_lineDescription))
        {
            _error = "Choose an item or type a description.";
            return false;
        }

        if (_lineQuantity <= 0)
        {
            _error = "The quantity must be greater than zero.";
            return false;
        }

        _lines.Add(new PurchaseOrderLineInput(_lineItemId, _lineDescription, _lineQuantity, _lineUnitPrice));
        ClearLine();
        return true;
    }

    private void AddLine()
    {
        _error = null;
        TakeTypedLine();
    }

    private async Task SaveAsync()
    {
        _error = null;

        // Pressing Save with a line still in the boxes should not throw it away.
        if (HasTypedLine && !TakeTypedLine())
        {
            return;
        }

        try
        {
            var input = new PurchaseOrderInput(_supplierId, _date, _expected, _currency, _lines);

            if (_editId is int id) await Orders.UpdateAsync(id, input);
            else await Orders.CreateAsync(input);

            _open = false;
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.InnerException?.Message ?? ex.Message; }
    }

    private async Task CloseOrderAsync(int id)
    {
        _pageError = null;
        try
        {
            await Orders.CloseAsync(id);
            await LoadAsync();
        }
        catch (Exception ex) { _pageError = ex.InnerException?.Message ?? ex.Message; }
    }
}
