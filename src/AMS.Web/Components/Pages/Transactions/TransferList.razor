@page "/transfers"
@inject ITransferService Transfers
@inject ICrudService<Employee> Employees
@inject ICrudService<Department> Departments
@inject ICrudService<Location> Locations
@inject ICrudService<User> Users
@inject ICurrentUserService CurrentUser

<PageTitle>Transfers</PageTitle>

<div class="ams-page-head">
    <div>
        <h1>Transfers</h1>
        <div class="sub">@_total transfer(s) — approve, then confirm receipt on arrival</div>
    </div>
    <button class="ams-btn" @onclick="OpenNew">+ Transfer Asset</button>
</div>

@if (_error is not null)
{
    <div class="ams-alert">@_error</div>
}

<div class="ams-card">
    <div class="ams-toolbar ams-filters">
        <select @bind="_status" @bind:after="FilterAsync">
            <option value="">All statuses</option>
            <option value="@RequestStatus.Pending">Pending</option>
            <option value="In transit">In transit</option>
            <option value="Received">Received</option>
            <option value="@RequestStatus.Rejected">Rejected</option>
        </select>
    </div>

    @if (_rows is null)
    {
        <div class="ams-empty">Loading&hellip;</div>
    }
    else if (_rows.Count == 0)
    {
        <div class="ams-empty">No transfers.</div>
    }
    else
    {
        <table class="ams-table">
            <thead>
                <tr>
                    <th>Date</th><th>Asset</th><th>From</th><th>To</th><th>Status</th>
                    <th>Dispatched</th><th>Received</th><th>Requested by</th><th>Rejection reason</th>
                    <th class="actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in _rows)
                {
                    var asset = t.Lines.FirstOrDefault()?.Asset;
                    <tr>
                        <td>@t.Date?.ToString("yyyy-MM-dd")</td>
                        <td>
                            @if (asset is not null)
                            {
                                <a class="ams-link" href="assets/@asset.Id">@asset.AssetNumber</a>
                                <span> @asset.Name</span>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>
                        <td>@Place(t.FromCustodian?.Name, t.FromDepartment?.Name, t.FromLocation?.Name)</td>
                        <td>@Place(t.ToCustodian?.Name, t.ToDepartment?.Name, t.ToLocation?.Name)</td>
                        <td><RequestStatusBadge Status="@t.Status" /></td>
                        <td>@t.DispatchDate?.ToString("yyyy-MM-dd")</td>
                        <td>@t.ReceiveConfirmationDate?.ToString("yyyy-MM-dd")</td>
                        <td><UserName Id="t.CreatedById" Names="_userNames" /></td>
                        <td class="ams-reason">@(t.Status == RequestStatus.Rejected ? t.Approval?.Comments : "")</td>
                        <td class="actions">
                            @if (t.Status == RequestStatus.Pending && _isApprover)
                            {
                                <button class="ams-btn link" @onclick="() => ApproveAsync(t.Id)">Approve</button>
                                <button class="ams-btn link danger" @onclick="() => OpenReject(t.Id)">Reject</button>
                            }
                            else if (t.Status == "In transit")
                            {
                                <button class="ams-btn link" @onclick="() => ConfirmAsync(t.Id)">Confirm receipt</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <Pager Page="_page" Total="_total" PageChanged="GoToAsync" />
    }
</div>

<ModalForm Visible="_open" Error="@_error" Title="Transfer asset" OnSave="SaveAsync" OnCancel="Close">
    <div class="ams-grid">
        <div class="ams-field">
            <label>Asset *</label>
            @if (_assets.Count == 0)
            {
                <div class="ams-readonly">No asset can be transferred — only active assets that are In store or Assigned with no transfer in progress.</div>
            }
            else
            {
                <select @bind="_assetId" @bind:after="OnAssetChanged">
                    <option value="0">— select —</option>
                    @foreach (var a in _assets)
                    {
                        <option value="@a.Id">@a.AssetNumber — @a.Name</option>
                    }
                </select>
            }
        </div>

        <div class="ams-field">
            <label>Currently with</label>
            <div class="ams-readonly">@_from</div>
        </div>

        <div class="ams-field">
            <label>To custodian</label>
            <select @bind="_toCustodianId" @bind:after="OnCustodianChanged">
                <option value="">— none (stays in store) —</option>
                @foreach (var e in _employees)
                {
                    <option value="@e.Id">@e.EmployeeNumber — @e.Name</option>
                }
            </select>
        </div>

        <div class="ams-field">
            <label>To department</label>
            <select @bind="_toDepartmentId">
                <option value="">— none —</option>
                @foreach (var d in _departments)
                {
                    <option value="@d.Id">@d.Name</option>
                }
            </select>
        </div>

        <div class="ams-field">
            <label>To location</label>
            <select @bind="_toLocationId">
                <option value="">— none —</option>
                @foreach (var l in _locations)
                {
                    <option value="@l.Id">@l.Name</option>
                }
            </select>
        </div>

        <div class="ams-field">
            <label>Transfer date *</label>
            <input type="date" @bind="_date" />
        </div>
    </div>

    <p class="ams-hint">
        Give at least one destination. Once the approver approves, the asset becomes
        <strong>In transit</strong>; it takes the new custodian, department and location only when
        someone confirms its receipt.
    </p>
</ModalForm>

<ModalForm Visible="_rejectId is not null" Error="@_error" Title="Reject transfer" OnSave="RejectAsync" OnCancel="CloseReject">
    <div class="ams-field">
        <label>Reason * <span class="ams-muted">(the requester will see it)</span></label>
        <textarea rows="3" @bind="_reason"></textarea>
    </div>
</ModalForm>

@code {
    [SupplyParameterFromQuery] public int? AssetId { get; set; }

    private List<Transfer>? _rows;
    private List<Asset> _assets = new();
    private List<Employee> _employees = new();
    private List<Department> _departments = new();
    private List<Location> _locations = new();
    private Dictionary<int, string> _userNames = new();

    private string _status = string.Empty;
    private bool _isApprover;
    private int _total;
    private int _page = 1;


    private bool _open;
    private int _assetId;
    private string _from = "—";
    private int? _toCustodianId;
    private int? _toDepartmentId;
    private int? _toLocationId;
    private DateTime _date = DateTime.Today;

    private int? _rejectId;
    private string _reason = string.Empty;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _employees = await Employees.GetAllAsync();
            _departments = await Departments.GetAllAsync();
            _locations = await Locations.GetAllAsync();
            _userNames = (await Users.GetAllAsync(true)).ToDictionary(u => u.Id, u => u.Username);
            _isApprover = await CurrentUser.IsInRoleAsync(AppRoles.Admin);
        }
        catch (Exception ex) { _error = ex.Message; }

        await LoadAsync();

        if (AssetId is int id)
        {
            OpenNew();
            if (_assets.Any(a => a.Id == id))
            {
                _assetId = id;
                OnAssetChanged();
            }
            else
            {
                _error = "That asset cannot be transferred right now.";
            }
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            var result = await Transfers.GetAllAsync(string.IsNullOrEmpty(_status) ? null : _status, _page);
            _rows = result.Items;
            _total = result.Total;
            _assets = await Transfers.GetTransferableAssetsAsync();
            _error = null;
        }
        catch (Exception ex) { _error = ex.Message; }
    }


    private async Task GoToAsync(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private async Task FilterAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    private void OpenNew()
    {
        _assetId = 0;
        _from = "—";
        _toCustodianId = null;
        _toDepartmentId = null;
        _toLocationId = null;
        _date = DateTime.Today;
        _error = null;
        _open = true;
    }

    private void Close() => _open = false;

    private void OnAssetChanged()
    {
        var asset = _assets.FirstOrDefault(a => a.Id == _assetId);
        _from = asset is null ? "—" : Place(asset.Custodian?.Name, null, asset.Location?.Name);
    }

    private void OnCustodianChanged()
    {
        if (_toCustodianId is int id)
        {
            _toDepartmentId ??= _employees.FirstOrDefault(e => e.Id == id)?.DepartmentId;
        }
    }

    private async Task SaveAsync()
    {
        _error = null;
        if (_assetId == 0) { _error = "Asset is required."; return; }
        if (_toCustodianId is null && _toDepartmentId is null && _toLocationId is null)
        {
            _error = "Give at least one destination: custodian, department or location.";
            return;
        }
        if (_date == default) { _error = "The date is required."; return; }

        try
        {
            await Transfers.CreateAsync(new TransferInput(_assetId, _toCustodianId, _toDepartmentId, _toLocationId, _date));
            _open = false;
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.InnerException?.Message ?? ex.Message; }
    }

    private async Task ApproveAsync(int id)
    {
        _error = null;
        try
        {
            await Transfers.ApproveAsync(id);
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.InnerException?.Message ?? ex.Message; }
    }

    private async Task ConfirmAsync(int id)
    {
        _error = null;
        try
        {
            await Transfers.ConfirmReceiptAsync(id);
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.InnerException?.Message ?? ex.Message; }
    }

    private void OpenReject(int id)
    {
        _rejectId = id;
        _reason = string.Empty;
        _error = null;
    }

    private void CloseReject() => _rejectId = null;

    private async Task RejectAsync()
    {
        if (_rejectId is null) return;
        if (string.IsNullOrWhiteSpace(_reason)) { _error = "A rejection reason is required."; return; }

        try
        {
            await Transfers.RejectAsync(_rejectId.Value, _reason);
            _rejectId = null;
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.InnerException?.Message ?? ex.Message; }
    }

    private static string Place(string? custodian, string? department, string? location)
    {
        var parts = new[] { custodian, department, location }.Where(p => !string.IsNullOrWhiteSpace(p));
        var text = string.Join(" · ", parts);
        return text.Length == 0 ? "Store" : text;
    }
}
