@page "/issuance"

<PageTitle>Asset Issuance</PageTitle>

<div class="ams-page-head">
    <div>
        <h1>Asset Issuance</h1>
        <div class="sub">@_total request(s)</div>
    </div>
    <button class="ams-btn" @onclick='() => Nav.NavigateTo("issuance/new")'>+ Issue Asset</button>
</div>

@if (_error is not null)
{
    <div class="ams-alert">@_error</div>
}

<div class="ams-card">
    <div class="ams-toolbar ams-filters">
        <select @bind="_status" @bind:after="FilterAsync">
            <option value="">All statuses</option>
            <option value="@RequestStatus.Pending">Pending</option>
            <option value="@RequestStatus.Approved">Approved</option>
            <option value="@RequestStatus.Rejected">Rejected</option>
        </select>
    </div>

    @if (_rows is null)
    {
        <div class="ams-empty">Loading&hellip;</div>
    }
    else if (_rows.Count == 0)
    {
        <div class="ams-empty">No issuance requests.</div>
    }
    else
    {
        <table class="ams-table">
            <thead>
                <tr>
                    <th>Date</th><th>Asset</th><th>Employee</th><th>Department</th><th>Location</th>
                    <th>From store</th><th>Status</th><th>Requested by</th><th>Rejection reason</th>
                    <th class="actions">Decision</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rows)
                {
                    <tr>
                        <td>@r.AssignmentDate?.ToString("yyyy-MM-dd")</td>
                        <td><a class="ams-link" href="assets/@r.AssetId">@r.Asset?.AssetNumber</a> @r.Asset?.Name</td>
                        <td>@(r.Custodian?.Name ?? "—")</td>
                        <td>@(r.Department?.Name ?? "—")</td>
                        <td>@(r.Location?.Name ?? "—")</td>
                        <td>@(r.Issue?.Store?.Name ?? "—")</td>
                        <td><RequestStatusBadge Status="@r.Status" /></td>
                        <td><UserName Id="r.CreatedById" Names="_userNames" /></td>
                        <td class="ams-reason">@(r.Status == RequestStatus.Rejected ? r.Approval?.Comments : "")</td>
                        <td class="actions">
                            @if (r.Status == RequestStatus.Pending && _isApprover)
                            {
                                <button class="ams-btn link" @onclick="() => ApproveAsync(r.Id)">Approve</button>
                                <button class="ams-btn link danger" @onclick="() => OpenReject(r.Id)">Reject</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <Pager Page="_page" Total="_total" PageChanged="GoToAsync" />
    }
</div>

<ModalForm Visible="_rejectId is not null" Error="@_error" Title="Reject request" OnSave="RejectAsync" OnCancel="CloseReject">
    <div class="ams-field">
        <label>Reason * <span class="ams-muted">(the requester will see it)</span></label>
        <textarea rows="3" @bind="_reason"></textarea>
    </div>
</ModalForm>
