@page "/issuance"
@inject IAssetIssuanceService Issuance
@inject ICrudService<User> Users
@inject ICurrentUserService CurrentUser
@inject NavigationManager Nav

<PageTitle>Asset Issuance</PageTitle>

<div class="ams-page-head">
    <div>
        <h1>Asset Issuance</h1>
        <div class="sub">@_total request(s)</div>
    </div>
    <button class="ams-btn" @onclick='() => Nav.NavigateTo("issuance/new")'>+ Issue Asset</button>
</div>

@if (_error is not null)
{
    <div class="ams-alert">@_error</div>
}

<div class="ams-card">
    <div class="ams-toolbar ams-filters">
        <select @bind="_status" @bind:after="FilterAsync">
            <option value="">All statuses</option>
            <option value="@RequestStatus.Pending">Pending</option>
            <option value="@RequestStatus.Approved">Approved</option>
            <option value="@RequestStatus.Rejected">Rejected</option>
        </select>
    </div>

    @if (_rows is null)
    {
        <div class="ams-empty">Loading&hellip;</div>
    }
    else if (_rows.Count == 0)
    {
        <div class="ams-empty">No issuance requests.</div>
    }
    else
    {
        <table class="ams-table">
            <thead>
                <tr>
                    <th>Date</th><th>Asset</th><th>Employee</th><th>Department</th><th>Location</th>
                    <th>From store</th><th>Status</th><th>Requested by</th><th>Rejection reason</th>
                    <th class="actions">Decision</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rows)
                {
                    <tr>
                        <td>@r.AssignmentDate?.ToString("yyyy-MM-dd")</td>
                        <td><a class="ams-link" href="assets/@r.AssetId">@r.Asset?.AssetNumber</a> @r.Asset?.Name</td>
                        <td>@(r.Custodian?.Name ?? "—")</td>
                        <td>@(r.Department?.Name ?? "—")</td>
                        <td>@(r.Location?.Name ?? "—")</td>
                        <td>@(r.Issue?.Store?.Name ?? "—")</td>
                        <td><RequestStatusBadge Status="@r.Status" /></td>
                        <td><UserName Id="r.CreatedById" Names="_userNames" /></td>
                        <td class="ams-reason">@(r.Status == RequestStatus.Rejected ? r.Approval?.Comments : "")</td>
                        <td class="actions">
                            @if (r.Status == RequestStatus.Pending && _isApprover)
                            {
                                <button class="ams-btn link" @onclick="() => ApproveAsync(r.Id)">Approve</button>
                                <button class="ams-btn link danger" @onclick="() => OpenReject(r.Id)">Reject</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <Pager Page="_page" Total="_total" PageChanged="GoToAsync" />
    }
</div>

<ModalForm Visible="_rejectId is not null" Error="@_error" Title="Reject request" OnSave="RejectAsync" OnCancel="CloseReject">
    <div class="ams-field">
        <label>Reason * <span class="ams-muted">(the requester will see it)</span></label>
        <textarea rows="3" @bind="_reason"></textarea>
    </div>
</ModalForm>

@code {
    private List<AssetAssignment>? _rows;
    private Dictionary<int, string> _userNames = new();
    private string _status = string.Empty;
    private bool _isApprover;
    private int _total;
    private int _page = 1;


    private int? _rejectId;
    private string _reason = string.Empty;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _userNames = (await Users.GetAllAsync(true)).ToDictionary(u => u.Id, u => u.Username);
            _isApprover = await CurrentUser.IsInRoleAsync(AppRoles.Admin);
        }
        catch (Exception ex) { _error = ex.Message; }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            var result = await Issuance.GetAllAsync(string.IsNullOrEmpty(_status) ? null : _status, _page);
            _rows = result.Items;
            _total = result.Total;
            _error = null;
        }
        catch (Exception ex) { _error = ex.Message; }
    }


    private async Task GoToAsync(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private async Task FilterAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task ApproveAsync(int id)
    {
        _error = null;
        try
        {
            await Issuance.ApproveAsync(id);
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.InnerException?.Message ?? ex.Message; }
    }

    private void OpenReject(int id)
    {
        _rejectId = id;
        _reason = string.Empty;
        _error = null;
    }

    private void CloseReject() => _rejectId = null;

    private async Task RejectAsync()
    {
        if (_rejectId is null) return;
        if (string.IsNullOrWhiteSpace(_reason)) { _error = "A rejection reason is required."; return; }

        try
        {
            await Issuance.RejectAsync(_rejectId.Value, _reason);
            _rejectId = null;
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.InnerException?.Message ?? ex.Message; }
    }
}
