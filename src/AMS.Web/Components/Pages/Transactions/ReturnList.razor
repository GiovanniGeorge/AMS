@page "/returns"

<PageTitle>Returns</PageTitle>

<div class="ams-page-head">
    <div>
        <h1>Returns</h1>
        <div class="sub">@_total return(s) — an asset coming back from an employee into a store</div>
    </div>
    <button class="ams-btn" @onclick="OpenNew">+ Return Asset</button>
</div>

@if (_error is not null)
{
    <div class="ams-alert">@_error</div>
}

<div class="ams-card">
    @if (_rows is null)
    {
        <div class="ams-empty">Loading&hellip;</div>
    }
    else if (_rows.Count == 0)
    {
        <div class="ams-empty">No returns yet.</div>
    }
    else
    {
        <table class="ams-table">
            <thead>
                <tr>
                    <th>Date</th><th>Asset</th><th>Returned by</th><th>To store</th>
                    <th>Condition</th><th>Reason</th><th>Recorded by</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rows)
                {
                    <tr>
                        <td>@r.Date?.ToString("yyyy-MM-dd")</td>
                        <td><a class="ams-link" href="assets/@r.AssetId">@r.Asset?.AssetNumber</a> @r.Asset?.Name</td>
                        <td>@(r.Employee?.Name ?? "—")</td>
                        <td>@(r.Store?.Name ?? "—")</td>
                        <td>@(r.Condition ?? "—")</td>
                        <td>@(r.Reason ?? "—")</td>
                        <td><UserName Id="r.CreatedById" Names="_userNames" /></td>
                    </tr>
                }
            </tbody>
        </table>

        <Pager Page="_page" Total="_total" PageChanged="GoToAsync" />
    }
</div>

<ModalForm Visible="_open" Error="@_error" Title="Return asset" OnSave="SaveAsync" OnCancel="Close">
    <div class="ams-grid">
        <div class="ams-field">
            <label>Asset *</label>
            @if (_assets.Count == 0)
            {
                <div class="ams-readonly">No asset can be returned — only assets that are <strong>Assigned</strong>.</div>
            }
            else
            {
                <select @bind="_assetId" @bind:after="OnAssetChanged">
                    <option value="0">— select —</option>
                    @foreach (var a in _assets)
                    {
                        <option value="@a.Id">@a.AssetNumber — @a.Name</option>
                    }
                </select>
            }
        </div>

        <div class="ams-field">
            <label>Returned by *</label>
            <select @bind="_employeeId">
                <option value="0">— select —</option>
                @foreach (var e in _employees)
                {
                    <option value="@e.Id">@e.EmployeeNumber — @e.Name</option>
                }
            </select>
            <QuickAddEmployee OnAdded="QuickEmployeeAddedAsync" />
        </div>

        <div class="ams-field">
            <label>To store *</label>
            @if (_stores.Count == 0)
            {
                <div class="ams-readonly">No stores yet — <a class="ams-link" href="master/stores">add them in Stores</a>.</div>
            }
            else
            {
                <select @bind="_storeId">
                    <option value="0">— select —</option>
                    @foreach (var s in _stores)
                    {
                        <option value="@s.Id">@s.Name</option>
                    }
                </select>
                <QuickAdd TItem="Store" What="store" OnAdded="QuickStoreAddedAsync" />
            }
        </div>

        <div class="ams-field">
            <label>Return date *</label>
            <input type="date" @bind="_date" />
        </div>

        <div class="ams-field">
            <label>Condition</label>
            <input @bind="_condition" placeholder="Good / Needs repair ..." />
        </div>
    </div>

    <div class="ams-field">
        <label>Reason</label>
        <textarea rows="2" @bind="_reason"></textarea>
    </div>

    <p class="ams-hint">
        No approval is needed. The asset becomes <strong>In store</strong>, its custodian is cleared
        and the open custody is closed with this date.
    </p>
</ModalForm>
