@page "/audit-log"
@attribute [Authorize(Roles = AppRoles.Admin)]
@inject IAuditLogService Audit
@inject ICrudService<User> Users

<PageTitle>Audit Log</PageTitle>

<div class="ams-page-head">
    <div>
        <h1>Audit Log</h1>
        <div class="sub">@_total entry(ies)@(_total > PageSize ? $" · page {_page} of {Pages}" : "")</div>
    </div>
</div>

@if (_error is not null)
{
    <div class="ams-alert">@_error</div>
}

<div class="ams-card">
    <div class="ams-toolbar ams-filters">
        <select @bind="_action" @bind:after="SearchAsync">
            <option value="">All actions</option>
            @foreach (var a in Enum.GetValues<AuditAction>())
            {
                <option value="@a">@a</option>
            }
        </select>

        <select @bind="_entityName" @bind:after="SearchAsync">
            <option value="">All entities</option>
            @foreach (var n in _entityNames)
            {
                <option value="@n">@n</option>
            }
        </select>

        <select @bind="_userId" @bind:after="SearchAsync">
            <option value="">All users</option>
            @foreach (var u in _users)
            {
                <option value="@u.Id">@u.Username</option>
            }
        </select>

        <input type="date" @bind="_from" @bind:after="SearchAsync" />
        <input type="date" @bind="_to" @bind:after="SearchAsync" />
    </div>

    @if (_rows is null)
    {
        <div class="ams-empty">Loading&hellip;</div>
    }
    else if (_rows.Count == 0)
    {
        <div class="ams-empty">Nothing recorded for these filters.</div>
    }
    else
    {
        <table class="ams-table">
            <thead>
                <tr><th>When</th><th>User</th><th>Action</th><th>Entity</th><th>Record</th><th>Before</th><th>After</th></tr>
            </thead>
            <tbody>
                @foreach (var a in _rows)
                {
                    <tr>
                        <td>@a.DateTime?.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@(a.User?.Username ?? "—")</td>
                        <td>@(a.Action?.ToString() ?? "—")</td>
                        <td>@(a.EntityName ?? "—")</td>
                        <td>@(a.RecordId ?? "—")</td>
                        <td class="ams-reason">@Short(a.OldValues)</td>
                        <td class="ams-reason">@Short(a.NewValues)</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Pages > 1)
        {
            <div class="ams-toolbar" style="justify-content:space-between;">
                <button class="ams-btn ghost" @onclick="PreviousAsync" disabled="@(_page <= 1)">&larr; Previous</button>
                <span class="ams-muted">Page @_page of @Pages</span>
                <button class="ams-btn ghost" @onclick="NextAsync" disabled="@(_page >= Pages)">Next &rarr;</button>
            </div>
        }
    }
</div>

<p class="ams-hint">
    Every insert, update and deactivation is recorded, plus login, logout and failed login.
    A Deactivate is written as <strong>Delete</strong> because AMS never removes a row.
    Passwords are never recorded.
</p>

@code {
    private const int PageSize = 50;

    private List<AuditLog>? _rows;
    private List<User> _users = new();
    private List<string> _entityNames = new();

    private string _action = string.Empty;
    private string _entityName = string.Empty;
    private int? _userId;
    private DateTime? _from;
    private DateTime? _to;

    private int _total;
    private int _page = 1;
    private string? _error;

    private int Pages => _total == 0 ? 1 : (_total + PageSize - 1) / PageSize;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _users = await Users.GetAllAsync(true);
            _entityNames = await Audit.GetEntityNamesAsync();
        }
        catch (Exception ex) { _error = ex.Message; }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            AuditAction? action = Enum.TryParse<AuditAction>(_action, out var a) ? a : null;

            var result = await Audit.SearchAsync(new AuditFilter(
                action,
                string.IsNullOrEmpty(_entityName) ? null : _entityName,
                _userId,
                _from,
                _to,
                _page,
                PageSize));

            _rows = result.Items;
            _total = result.Total;
            _error = null;
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task SearchAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task PreviousAsync()
    {
        if (_page <= 1) return;
        _page--;
        await LoadAsync();
    }

    private async Task NextAsync()
    {
        if (_page >= Pages) return;
        _page++;
        await LoadAsync();
    }

    private static string Short(string? json)
    {
        if (string.IsNullOrEmpty(json)) return "—";
        return json.Length <= 160 ? json : json[..160] + "…";
    }
}
