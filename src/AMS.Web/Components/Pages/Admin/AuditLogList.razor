@page "/audit-log"
@attribute [Authorize(Roles = AppRoles.Admin)]

<PageTitle>Audit Log</PageTitle>

<div class="ams-page-head">
    <div>
        <h1>Audit Log</h1>
        <div class="sub">@_total entry(ies)@(_total > PageSize ? $" · page {_page} of {Pages}" : "")</div>
    </div>
</div>

@if (_error is not null)
{
    <div class="ams-alert">@_error</div>
}

<div class="ams-card">
    <div class="ams-toolbar ams-filters">
        <select @bind="_action" @bind:after="SearchAsync">
            <option value="">All actions</option>
            @foreach (var a in Enum.GetValues<AuditAction>())
            {
                <option value="@a">@a</option>
            }
        </select>

        <select @bind="_entityName" @bind:after="SearchAsync">
            <option value="">All entities</option>
            @foreach (var n in _entityNames)
            {
                <option value="@n">@n</option>
            }
        </select>

        <select @bind="_userId" @bind:after="SearchAsync">
            <option value="">All users</option>
            @foreach (var u in _users)
            {
                <option value="@u.Id">@u.Username</option>
            }
        </select>

        <input type="date" @bind="_from" @bind:after="SearchAsync" />
        <input type="date" @bind="_to" @bind:after="SearchAsync" />
    </div>

    @if (_rows is null)
    {
        <div class="ams-empty">Loading&hellip;</div>
    }
    else if (_rows.Count == 0)
    {
        <div class="ams-empty">Nothing recorded for these filters.</div>
    }
    else
    {
        <table class="ams-table">
            <thead>
                <tr><th>When</th><th>User</th><th>Action</th><th>Entity</th><th>Record</th><th>Before</th><th>After</th></tr>
            </thead>
            <tbody>
                @foreach (var a in _rows)
                {
                    <tr>
                        <td>@a.DateTime?.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@(a.User?.Username ?? "—")</td>
                        <td>@(a.Action?.ToString() ?? "—")</td>
                        <td>@(a.EntityName ?? "—")</td>
                        <td>@(a.RecordId ?? "—")</td>
                        <td class="ams-reason">@Short(a.OldValues)</td>
                        <td class="ams-reason">@Short(a.NewValues)</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Pages > 1)
        {
            <div class="ams-toolbar" style="justify-content:space-between;">
                <button class="ams-btn ghost" @onclick="PreviousAsync" disabled="@(_page <= 1)">&larr; Previous</button>
                <span class="ams-muted">Page @_page of @Pages</span>
                <button class="ams-btn ghost" @onclick="NextAsync" disabled="@(_page >= Pages)">Next &rarr;</button>
            </div>
        }
    }
</div>

<p class="ams-hint">
    Every insert, update and deactivation is recorded, plus login, logout and failed login.
    A Deactivate is written as <strong>Delete</strong> because AMS never removes a row.
    Passwords are never recorded.
</p>
