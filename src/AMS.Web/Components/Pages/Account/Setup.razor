@page "/account/setup"
@layout AMS.Web.Components.Layout.AuthLayout
@attribute [AllowAnonymous]

@* First-time setup. Works ONLY while there are no users at all.
   After the first user is created this page always redirects to Login. *@

<PageTitle>First-time setup</PageTitle>

<h1 class="ams-auth-title">Create the first user</h1>
<p class="ams-auth-sub">
    No users exist yet. This page works only once &mdash; after the first user is created it closes permanently.
</p>

@if (_error is not null)
{
    <div class="ams-alert">@_error</div>
}

<EditForm Model="Input" method="post" OnSubmit="CreateAsync" FormName="setup">
    <div class="ams-field">
        <label for="username">Username</label>
        <InputText id="username" @bind-Value="Input.Username" autocomplete="username" autofocus />
    </div>
    <div class="ams-field">
        <label for="password">Password</label>
        <InputText id="password" type="password" @bind-Value="Input.Password" autocomplete="new-password" />
    </div>
    <div class="ams-field">
        <label for="confirm">Confirm password</label>
        <InputText id="confirm" type="password" @bind-Value="Input.ConfirmPassword" autocomplete="new-password" />
    </div>
    <button type="submit" class="ams-btn ams-btn-block">Create user</button>
</EditForm>
