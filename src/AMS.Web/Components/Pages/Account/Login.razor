@page "/account/login"
@layout AMS.Web.Components.Layout.AuthLayout
@attribute [AllowAnonymous]

<PageTitle>Sign in</PageTitle>

<h1 class="ams-auth-title">Sign in</h1>

@if (Created == "1")
{
    <div class="ams-info">Your account was created. You can sign in now.</div>
}

@if (_error is not null)
{
    <div class="ams-alert">@_error</div>
}

<EditForm Model="Input" method="post" OnSubmit="LoginAsync" FormName="login">
    <div class="ams-field">
        <label for="username">Username</label>
        <InputText id="username" @bind-Value="Input.Username" autocomplete="username" autofocus />
    </div>
    <div class="ams-field">
        <label for="password">Password</label>
        <InputText id="password" type="password" @bind-Value="Input.Password" autocomplete="current-password" />
    </div>
    <button type="submit" class="ams-btn ams-btn-block">Sign in</button>
</EditForm>
