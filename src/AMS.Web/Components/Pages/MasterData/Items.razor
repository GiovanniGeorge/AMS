@page "/master/items"
@inject ICrudService<Item> Service
@inject ICrudService<User> UserService
@inject ICrudService<Unit> Units

<PageTitle>Items</PageTitle>

<div class="ams-page-head">
    <div>
        <h1>Items</h1>
        <div class="sub">Consumable / stock items &middot; @(_rows?.Count ?? 0) record(s)</div>
    </div>
    <button class="ams-btn" @onclick="OpenNew">+ New Item</button>
</div>

@if (_error is not null)
{
    <div class="ams-alert">@_error</div>
}

<div class="ams-card">
    <div class="ams-toolbar">
        <label><input type="checkbox" @bind="_showInactive" @bind:after="LoadAsync" /> Show inactive</label>
    </div>

    @if (_rows is null)
    {
        <div class="ams-empty">Loading&hellip;</div>
    }
    else if (_rows.Count == 0)
    {
        <div class="ams-empty">No records yet.</div>
    }
    else
    {
        <table class="ams-table">
            <thead>
                <tr>
                    <th>#</th><th>Name</th><th>Unit</th>
                    <th class="num">Min. Level</th><th class="num">Reorder Point</th>
                    <th>Expiry</th><th>Created by</th><th>Status</th><th class="actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rows)
                {
                    <tr class="@(r.IsActive ? "" : "is-inactive")">
                        <td>@r.Id</td>
                        <td>@r.Name</td>
                        <td>@(r.UnitOfMeasure?.Name ?? "—")</td>
                        <td class="num">@r.MinimumLevel</td>
                        <td class="num">@r.ReorderPoint</td>
                        <td>@r.ExpiryDate?.ToString("yyyy-MM-dd")</td>
                        <td><UserName Id="r.CreatedById" Names="_userNames" /></td>
                        <td><StatusBadge Active="r.IsActive" /></td>
                        <td class="actions">
                            <button class="ams-btn link" @onclick="() => OpenEditAsync(r.Id)">Edit</button>
                            <button class="ams-btn link @(r.IsActive ? "danger" : "")" @onclick="() => ToggleAsync(r)">
                                @(r.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<ModalForm Visible="_editing is not null" Error="@_error" Title="@_title" OnSave="SaveAsync" OnCancel="Cancel">
    @if (_editing is not null)
    {
        <div class="ams-field"><label>Name *</label><input @bind="_editing.Name" /></div>
        <div class="ams-field"><label>Description</label><textarea rows="2" @bind="_editing.Description"></textarea></div>
        <div class="ams-field">
            <label>Unit of Measure *</label>
            @if (_units.Count == 0)
            {
                <div class="ams-empty" style="padding:8px 0;">No units defined yet — add them in Units first.</div>
            }
            else
            {
                <select @bind="_editing.UnitOfMeasureId">
                    <option value="0">— select —</option>
                    @foreach (var u in _units)
                    {
                        <option value="@u.Id">@u.Name</option>
                    }
                </select>
            }
        </div>
        <div class="ams-field"><label>Minimum Level</label><input type="number" step="0.01" @bind="_editing.MinimumLevel" /></div>
        <div class="ams-field"><label>Reorder Point</label><input type="number" step="0.01" @bind="_editing.ReorderPoint" /></div>
        <div class="ams-field"><label>Expiry Date</label><input type="date" @bind="_editing.ExpiryDate" /></div>
    }
</ModalForm>

@code {
    private List<Item>? _rows;
    private List<Unit> _units = new();
    private Item? _editing;
    private string _title = string.Empty;
    private bool _showInactive;
    private string? _error;
    private Dictionary<int, string> _userNames = new();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _rows = await Service.GetAllAsync(_showInactive, i => i.UnitOfMeasure!); _userNames = (await UserService.GetAllAsync(true)).ToDictionary(u => u.Id, u => u.Username);
            _units = await Units.GetAllAsync();
            _error = null;
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private void OpenNew() { _editing = new Item(); _title = "New Item"; _error = null; }

    private async Task OpenEditAsync(int id)
    {
        _editing = await Service.GetByIdAsync(id);
        _title = "Edit Item";
        _error = null;
    }

    private void Cancel() { _editing = null; _error = null; }

    private async Task SaveAsync()
    {
        if (_editing is null) return;
        if (string.IsNullOrWhiteSpace(_editing.Name)) { _error = "Name is required."; return; }
        if (_editing.UnitOfMeasureId == 0) { _error = "Unit of measure is required."; return; }

        try
        {
            _editing.UnitOfMeasure = null;
            if (_editing.Id == 0) await Service.AddAsync(_editing);
            else await Service.UpdateAsync(_editing);

            _editing = null;
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.InnerException?.Message ?? ex.Message; }
    }

    private async Task ToggleAsync(Item r)
    {
        if (r.IsActive) await Service.DeactivateAsync(r.Id);
        else await Service.ActivateAsync(r.Id);
        await LoadAsync();
    }
}
