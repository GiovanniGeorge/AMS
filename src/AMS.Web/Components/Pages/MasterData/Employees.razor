@page "/master/employees"

<PageTitle>Employees</PageTitle>

<div class="ams-page-head">
    <div>
        <h1>Employees</h1>
        <div class="sub">Master data &middot; @_total record(s)</div>
    </div>
    <button class="ams-btn" @onclick="OpenNew">+ New Employee</button>
</div>

@if (_error is not null)
{
    <div class="ams-alert">@_error</div>
}

<div class="ams-card">
    <div class="ams-toolbar ams-filters">
        <input class="ams-search" placeholder="Search name or employee number…"
               @bind="_search" @bind:after="SearchAsync" />

        <select @bind="_departmentId" @bind:after="SearchAsync">
            <option value="">All departments</option>
            @foreach (var d in _departments)
            {
                <option value="@d.Id">@d.Name</option>
            }
        </select>
        <QuickAdd TItem="Department" What="department" OnAdded="QuickDepartmentAddedAsync" />

        <label><input type="checkbox" @bind="_showInactive" @bind:after="SearchAsync" /> Show inactive</label>
    </div>

    @if (_rows is null)
    {
        <div class="ams-empty">Loading&hellip;</div>
    }
    else if (_rows.Count == 0)
    {
        <div class="ams-empty">No employee matches this search.</div>
    }
    else
    {
        <table class="ams-table">
            <thead>
                <tr>
                    <th>Employee No.</th><th>Name</th><th>Department</th><th>Assets held</th>
                    <th>Created by</th><th>Status</th><th class="actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rows)
                {
                    <tr class="@(r.IsActive ? "" : "is-inactive")">
                        <td><a class="ams-link" href="master/employees/@r.Id">@r.EmployeeNumber</a></td>
                        <td><a class="ams-link" href="master/employees/@r.Id">@r.Name</a></td>
                        <td>@(r.Department?.Name ?? "—")</td>
                        <td>@(_counts.TryGetValue(r.Id, out var n) ? n : 0)</td>
                        <td><UserName Id="r.CreatedById" Names="_userNames" /></td>
                        <td><StatusBadge Active="r.IsActive" /></td>
                        <td class="actions">
                            <button class="ams-btn link" @onclick='() => Nav.NavigateTo($"master/employees/{r.Id}")'>View</button>
                            <button class="ams-btn link" @onclick="() => OpenEditAsync(r.Id)">Edit</button>
                            <button class="ams-btn link @(r.IsActive ? "danger" : "")" @onclick="() => ToggleAsync(r)">
                                @(r.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <Pager Page="_page" Total="_total" PageChanged="GoToPageAsync" />
    }
</div>

<ModalForm Visible="_editing is not null" Error="@_error" Title="@_title" OnSave="SaveAsync" OnCancel="Cancel">
    @if (_editing is not null)
    {
        <div class="ams-field"><label>Employee Number *</label><input @bind="_editing.EmployeeNumber" /></div>
        <div class="ams-field"><label>Name *</label><input @bind="_editing.Name" /></div>
        <div class="ams-field">
            <label>Department</label>
            <select @bind="_editing.DepartmentId">
                <option value="">— none —</option>
                @foreach (var d in _departments)
                {
                    <option value="@d.Id">@d.Name</option>
                }
            </select>
        </div>
    }
</ModalForm>
