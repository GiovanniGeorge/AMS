@page "/master/employees"
@inject IDirectoryService Directory
@inject ICrudService<Employee> Service
@inject ICrudService<User> UserService
@inject ICrudService<Department> Departments
@inject NavigationManager Nav

<PageTitle>Employees</PageTitle>

<div class="ams-page-head">
    <div>
        <h1>Employees</h1>
        <div class="sub">Master data &middot; @_total record(s)</div>
    </div>
    <button class="ams-btn" @onclick="OpenNew">+ New Employee</button>
</div>

@if (_error is not null)
{
    <div class="ams-alert">@_error</div>
}

<div class="ams-card">
    <div class="ams-toolbar ams-filters">
        <input class="ams-search" placeholder="Search name or employee number…"
               @bind="_search" @bind:after="SearchAsync" />

        <select @bind="_departmentId" @bind:after="SearchAsync">
            <option value="">All departments</option>
            @foreach (var d in _departments)
            {
                <option value="@d.Id">@d.Name</option>
            }
        </select>

        <label><input type="checkbox" @bind="_showInactive" @bind:after="SearchAsync" /> Show inactive</label>
    </div>

    @if (_rows is null)
    {
        <div class="ams-empty">Loading&hellip;</div>
    }
    else if (_rows.Count == 0)
    {
        <div class="ams-empty">No employee matches this search.</div>
    }
    else
    {
        <table class="ams-table">
            <thead>
                <tr>
                    <th>Employee No.</th><th>Name</th><th>Department</th><th>Assets held</th>
                    <th>Created by</th><th>Status</th><th class="actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rows)
                {
                    <tr class="@(r.IsActive ? "" : "is-inactive")">
                        <td><a class="ams-link" href="master/employees/@r.Id">@r.EmployeeNumber</a></td>
                        <td><a class="ams-link" href="master/employees/@r.Id">@r.Name</a></td>
                        <td>@(r.Department?.Name ?? "—")</td>
                        <td>@(_counts.TryGetValue(r.Id, out var n) ? n : 0)</td>
                        <td><UserName Id="r.CreatedById" Names="_userNames" /></td>
                        <td><StatusBadge Active="r.IsActive" /></td>
                        <td class="actions">
                            <button class="ams-btn link" @onclick='() => Nav.NavigateTo($"master/employees/{r.Id}")'>View</button>
                            <button class="ams-btn link" @onclick="() => OpenEditAsync(r.Id)">Edit</button>
                            <button class="ams-btn link @(r.IsActive ? "danger" : "")" @onclick="() => ToggleAsync(r)">
                                @(r.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <Pager Page="_page" Total="_total" PageChanged="GoToPageAsync" />
    }
</div>

<ModalForm Visible="_editing is not null" Title="@_title" OnSave="SaveAsync" OnCancel="Cancel">
    @if (_editing is not null)
    {
        <div class="ams-field"><label>Employee Number *</label><input @bind="_editing.EmployeeNumber" /></div>
        <div class="ams-field"><label>Name *</label><input @bind="_editing.Name" /></div>
        <div class="ams-field">
            <label>Department</label>
            <select @bind="_editing.DepartmentId">
                <option value="">— none —</option>
                @foreach (var d in _departments)
                {
                    <option value="@d.Id">@d.Name</option>
                }
            </select>
        </div>
    }
</ModalForm>

@code {
    private List<Employee>? _rows;
    private List<Department> _departments = new();
    private Dictionary<int, int> _counts = new();
    private Dictionary<int, string> _userNames = new();

    private Employee? _editing;
    private string _title = string.Empty;

    private string? _search;
    private int? _departmentId;
    private bool _showInactive;
    private string? _error;

    private int _page = 1;
    private int _total;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _departments = await Departments.GetAllAsync();
            _userNames = (await UserService.GetAllAsync(true)).ToDictionary(u => u.Id, u => u.Username);
        }
        catch (Exception ex) { _error = ex.Message; }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            var result = await Directory.SearchEmployeesAsync(
                new EmployeeFilter(_search, _departmentId, _showInactive, _page));

            _rows = result.Items;
            _total = result.Total;

            // One grouped query for the whole page, not one per row.
            _counts = await Directory.CountAssetsAsync(_rows.Select(r => r.Id));
            _error = null;
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    /// <summary>A changed filter always starts again at page 1.</summary>
    private async Task SearchAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task GoToPageAsync(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private void OpenNew() { _editing = new Employee(); _title = "New Employee"; _error = null; }

    private async Task OpenEditAsync(int id)
    {
        _editing = await Service.GetByIdAsync(id);
        _title = "Edit Employee";
        _error = null;
    }

    private void Cancel() { _editing = null; _error = null; }

    private async Task SaveAsync()
    {
        if (_editing is null) return;
        if (string.IsNullOrWhiteSpace(_editing.EmployeeNumber)) { _error = "Employee number is required."; return; }
        if (string.IsNullOrWhiteSpace(_editing.Name)) { _error = "Name is required."; return; }

        try
        {
            _editing.Department = null;
            if (_editing.Id == 0) await Service.AddAsync(_editing);
            else await Service.UpdateAsync(_editing);

            _editing = null;
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.InnerException?.Message ?? ex.Message; }
    }

    private async Task ToggleAsync(Employee r)
    {
        if (r.IsActive) await Service.DeactivateAsync(r.Id);
        else await Service.ActivateAsync(r.Id);
        await LoadAsync();
    }
}
