@page "/assets"
@inject IAssetService Assets
@inject ICrudService<Asset> AssetCrud
@inject ICrudService<Category> Categories
@inject ICrudService<Location> Locations
@inject ICrudService<User> Users
@inject NavigationManager Nav

<PageTitle>Assets Register</PageTitle>

<div class="ams-page-head">
    <div>
        <h1>Assets Register</h1>
        <div class="sub">@_total asset(s)@(_total > _pageSize ? $" · showing {_rows?.Count ?? 0} on page {_page} of {Pages}" : "")</div>
    </div>
    <div style="display:flex;gap:8px;">
        @if (_csv is null)
        {
            <button class="ams-btn ghost" @onclick="PrepareCsvAsync" disabled="@_building">Export CSV</button>
        }
        else
        {
            <a class="ams-btn ghost" href="@_csv" download="assets.csv">Download assets.csv</a>
        }
        <button class="ams-btn" @onclick='() => Nav.NavigateTo("assets/new")'>+ Register Asset</button>
    </div>
</div>

@if (_error is not null)
{
    <div class="ams-alert">@_error</div>
}

<div class="ams-card">
    <div class="ams-toolbar ams-filters">
        <input class="ams-search" placeholder="Search number, name, serial, barcode…"
               @bind="_search" @bind:after="SearchAsync" />

        <select @bind="_stage" @bind:after="SearchAsync">
            <option value="">All stages</option>
            @foreach (var stage in Enum.GetValues<LifecycleStage>())
            {
                <option value="@stage">@stage</option>
            }
        </select>

        <select @bind="_categoryId" @bind:after="SearchAsync">
            <option value="">All categories</option>
            @foreach (var c in _categories)
            {
                <option value="@c.Id">@c.Name</option>
            }
        </select>

        <select @bind="_locationId" @bind:after="SearchAsync">
            <option value="">All locations</option>
            @foreach (var l in _locations)
            {
                <option value="@l.Id">@l.Name</option>
            }
        </select>

        <label><input type="checkbox" @bind="_showInactive" @bind:after="SearchAsync" /> Show inactive</label>
    </div>

    @if (_rows is null)
    {
        <div class="ams-empty">Loading&hellip;</div>
    }
    else if (_rows.Count == 0)
    {
        <div class="ams-empty">No assets found.</div>
    }
    else
    {
        <table class="ams-table">
            <thead>
                <tr>
                    <th>Asset No.</th><th>Name</th><th>Category</th><th>Stage</th><th>Status</th>
                    <th>Location</th><th>Custodian</th><th>Created by</th><th class="actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rows)
                {
                    <tr class="@(r.IsActive ? "" : "is-inactive")">
                        <td><a class="ams-link" href="assets/@r.Id">@r.AssetNumber</a></td>
                        <td>@r.Name</td>
                        <td>@(r.Category?.Name ?? "—")</td>
                        <td><StageBadge Stage="r.LifecycleStage" /></td>
                        <td>@(r.Status?.Name ?? "—")</td>
                        <td>@(r.Location?.Name ?? "—")</td>
                        <td>@(r.Custodian?.Name ?? "—")</td>
                        <td><UserName Id="r.CreatedById" Names="_userNames" /></td>
                        <td class="actions">
                            <button class="ams-btn link" @onclick='() => Nav.NavigateTo($"assets/{r.Id}")'>View</button>
                            <button class="ams-btn link" @onclick='() => Nav.NavigateTo($"assets/{r.Id}/edit")'>Edit</button>
                            <button class="ams-btn link @(r.IsActive ? "danger" : "")" @onclick="() => ToggleAsync(r)">
                                @(r.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Pages > 1)
        {
            <div class="ams-toolbar" style="justify-content:space-between;">
                <button class="ams-btn ghost" @onclick="PreviousAsync" disabled="@(_page <= 1)">&larr; Previous</button>
                <span class="ams-muted">Page @_page of @Pages</span>
                <button class="ams-btn ghost" @onclick="NextAsync" disabled="@(_page >= Pages)">Next &rarr;</button>
            </div>
        }
    }
</div>

<p class="ams-hint">
    Deactivate is only for an asset registered by mistake. An asset that reaches the end of its life leaves through a Disposal request.
</p>

@code {
    private List<Asset>? _rows;
    private List<Category> _categories = new();
    private List<Location> _locations = new();
    private Dictionary<int, string> _userNames = new();

    private string? _search;
    private string _stage = string.Empty;
    private int? _categoryId;
    private int? _locationId;
    private bool _showInactive;
    private string? _error;

    private int _total;
    private int _page = 1;
    private const int _pageSize = 50;
    private string? _csv;
    private bool _building;

    private int Pages => _total == 0 ? 1 : (_total + _pageSize - 1) / _pageSize;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _categories = await Categories.GetAllAsync();
            _locations = await Locations.GetAllAsync();
            _userNames = (await Users.GetAllAsync(true)).ToDictionary(u => u.Id, u => u.Username);
        }
        catch (Exception ex) { _error = ex.Message; }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            var result = await Assets.SearchAsync(Filter(_page, _pageSize));
            _rows = result.Items;
            _total = result.Total;
            _error = null;
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private AssetFilter Filter(int page, int pageSize)
    {
        LifecycleStage? stage = Enum.TryParse<LifecycleStage>(_stage, out var s) ? s : null;
        return new AssetFilter(_search, stage, _categoryId, _locationId, _showInactive, page, pageSize);
    }

    /// <summary>A changed filter always starts again at page 1.</summary>
    private async Task SearchAsync()
    {
        _page = 1;
        _csv = null;
        await LoadAsync();
    }

    private async Task PreviousAsync()
    {
        if (_page <= 1) return;
        _page--;
        await LoadAsync();
    }

    private async Task NextAsync()
    {
        if (_page >= Pages) return;
        _page++;
        await LoadAsync();
    }

    /// <summary>
    /// Builds the CSV for every asset that matches the filter (not just this page) and
    /// turns it into a data: link, so no JavaScript and no download endpoint are needed.
    /// </summary>
    private async Task PrepareCsvAsync()
    {
        _building = true;
        _error = null;

        try
        {
            var all = await Assets.SearchAsync(Filter(1, 0));

            var text = new System.Text.StringBuilder();
            text.AppendLine("Asset No.,Name,Category,Stage,Status,Location,Department,Custodian,Serial,Purchase date,Purchase cost,Active");

            foreach (var a in all.Items)
            {
                text.AppendLine(string.Join(',', new[]
                {
                    Csv(a.AssetNumber), Csv(a.Name), Csv(a.Category?.Name), Csv(Stage(a.LifecycleStage)),
                    Csv(a.Status?.Name), Csv(a.Location?.Name), Csv(a.Department?.Name), Csv(a.Custodian?.Name),
                    Csv(a.SerialNumber), Csv(a.PurchaseDate?.ToString("yyyy-MM-dd")),
                    Csv(a.PurchaseCost?.ToString("0.00")), Csv(a.IsActive ? "Yes" : "No")
                }));
            }

            // The BOM makes Excel open the file as UTF-8.
            var bytes = System.Text.Encoding.UTF8.GetBytes("\uFEFF" + text.ToString());
            _csv = "data:text/csv;base64," + Convert.ToBase64String(bytes);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _building = false; }
    }

    private static string Stage(LifecycleStage stage) => stage switch
    {
        LifecycleStage.InStore => "In store",
        LifecycleStage.Assigned => "Assigned",
        LifecycleStage.InTransit => "In transit",
        LifecycleStage.UnderMaintenance => "Under maintenance",
        LifecycleStage.Disposed => "Disposed",
        _ => stage.ToString()
    };

    private static string Csv(string? value)
    {
        if (string.IsNullOrEmpty(value)) return "";
        return value.Contains(',') || value.Contains('"') || value.Contains('\n')
            ? "\"" + value.Replace("\"", "\"\"") + "\""
            : value;
    }

    private async Task ToggleAsync(Asset r)
    {
        if (r.IsActive) await AssetCrud.DeactivateAsync(r.Id);
        else await AssetCrud.ActivateAsync(r.Id);
        await LoadAsync();
    }
}
