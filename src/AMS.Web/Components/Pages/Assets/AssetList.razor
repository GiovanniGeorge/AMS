@page "/assets"

<PageTitle>Assets Register</PageTitle>

<div class="ams-page-head">
    <div>
        <h1>Assets Register</h1>
        <div class="sub">@_total asset(s)@(_total > _pageSize ? $" · showing {_rows?.Count ?? 0} on page {_page} of {Pages}" : "")</div>
    </div>
    <div style="display:flex;gap:8px;">
        @if (_csv is null)
        {
            <button class="ams-btn ghost" @onclick="PrepareCsvAsync" disabled="@_building">Export CSV</button>
        }
        else
        {
            <a class="ams-btn ghost" href="@_csv" download="assets.csv">Download assets.csv</a>
        }
        <button class="ams-btn" @onclick='() => Nav.NavigateTo("assets/new")'>+ Register Asset</button>
    </div>
</div>

@if (_error is not null)
{
    <div class="ams-alert">@_error</div>
}

@if (_notice is not null)
{
    <div class="ams-card" style="margin-bottom:12px;"><div class="ams-hint">@_notice</div></div>
}

<div class="ams-card">
    <div class="ams-toolbar ams-filters">
        <input class="ams-search" placeholder="Search number, name, serial, barcode…"
               @bind="_search" @bind:after="SearchAsync" />

        <select @bind="_stage" @bind:after="SearchAsync">
            <option value="">All stages</option>
            @foreach (var stage in Enum.GetValues<LifecycleStage>())
            {
                <option value="@stage">@stage.Label()</option>
            }
        </select>

        <select @bind="_categoryId" @bind:after="SearchAsync">
            <option value="">All categories</option>
            @foreach (var c in _categories)
            {
                <option value="@c.Id">@c.Name</option>
            }
        </select>

        <select @bind="_locationId" @bind:after="SearchAsync">
            <option value="">All locations</option>
            @foreach (var l in _locations)
            {
                <option value="@l.Id">@l.Name</option>
            }
        </select>

        <select @bind="_statusId" @bind:after="SearchAsync">
            <option value="">All conditions</option>
            @foreach (var st in _statuses)
            {
                <option value="@st.Id">@st.Name</option>
            }
        </select>

        <label><input type="checkbox" @bind="_showInactive" @bind:after="SearchAsync" /> Show inactive</label>
    </div>

    @if (_rows is null)
    {
        <div class="ams-empty">Loading&hellip;</div>
    }
    else if (_rows.Count == 0)
    {
        <div class="ams-empty">No assets found.</div>
    }
    else
    {
        <table class="ams-table">
            <thead>
                <tr>
                    <th>Asset No.</th><th>Name</th><th>Category</th><th>Stage</th><th>Status</th>
                    <th>Location</th><th>Custodian</th><th>Created by</th><th class="actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rows)
                {
                    <tr class="@(r.IsActive ? "" : "is-inactive")">
                        <td><a class="ams-link" href="assets/@r.Id">@r.AssetNumber</a></td>
                        <td>@r.Name</td>
                        <td>@(r.Category?.Name ?? "—")</td>
                        <td><StageBadge Stage="r.LifecycleStage" /></td>
                        <td>@(r.Status?.Name ?? "—")</td>
                        <td>@(r.Location?.Name ?? "—")</td>
                        <td>@(r.Custodian?.Name ?? "—")</td>
                        <td><UserName Id="r.CreatedById" Names="_userNames" /></td>
                        <td class="actions">
                            <button class="ams-btn link" @onclick='() => Nav.NavigateTo($"assets/{r.Id}")'>View</button>
                            <button class="ams-btn link" @onclick='() => Nav.NavigateTo($"assets/{r.Id}/edit")'>Edit</button>
                            @if (r.IsActive && r.LifecycleStage == LifecycleStage.InStore)
                            {
                                <button class="ams-btn link" @onclick="() => OpenAssign(r)">Assign</button>
                            }
                            <button class="ams-btn link @(r.IsActive ? "danger" : "")" @onclick="() => ToggleAsync(r)">
                                @(r.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Pages > 1)
        {
            <div class="ams-toolbar" style="justify-content:space-between;">
                <button class="ams-btn ghost" @onclick="PreviousAsync" disabled="@(_page <= 1)">&larr; Previous</button>
                <span class="ams-muted">Page @_page of @Pages</span>
                <button class="ams-btn ghost" @onclick="NextAsync" disabled="@(_page >= Pages)">Next &rarr;</button>
            </div>
        }
    }
</div>

<AssignAssetModal Visible="_assign is not null"
                  AssetId="_assign?.Id"
                  AssetLabel="@AssignLabel"
                  OnAssigned="OnAssignedAsync"
                  OnCancel="() => _assign = null" />

<p class="ams-hint">
    Deactivate is only for an asset registered by mistake. An asset that reaches the end of its life leaves through a Disposal request.
</p>
