@page "/depreciation"
@inject IDepreciationService Depreciation
@inject ICurrentUserService CurrentUser

<PageTitle>Depreciation</PageTitle>

<div class="ams-page-head">
    <div>
        <h1>Depreciation</h1>
        <div class="sub">Straight line from the purchase cost and the category's useful life and salvage value</div>
    </div>
</div>

@if (_error is not null)
{
    <div class="ams-alert">@_error</div>
}

@if (_posted is not null)
{
    <div class="ams-info">@_posted</div>
}

@if (!_isAdmin)
{
    <div class="ams-alert">Only the administrator can post depreciation. You can still look at what was posted.</div>
}

@* ------------------------------------------------ run a period *@
@if (_isAdmin)
{
    <section class="ams-section">
        <h2>Run a period</h2>

        <div class="ams-grid">
            <div class="ams-field">
                <label>Period *</label>
                <select @bind="_period" @bind:after="ClearPreview">
                    <option value="@DepreciationPeriod.Monthly">Monthly</option>
                    <option value="@DepreciationPeriod.Annual">Annual</option>
                </select>
            </div>

            <div class="ams-field">
                <label>Period ends on *</label>
                <input type="date" @bind="_periodEnd" @bind:after="ClearPreview" />
            </div>

            <div class="ams-field">
                <label>&nbsp;</label>
                <button class="ams-btn ghost" @onclick="PreviewAsync" disabled="@_busy">Preview</button>
            </div>
        </div>

        @if (_preview is not null)
        {
            <table class="ams-table">
                <thead>
                    <tr><th>Asset</th><th>Purchase cost</th><th>This period</th><th>Accumulated</th><th>Book value</th><th>Note</th></tr>
                </thead>
                <tbody>
                    @foreach (var l in _preview)
                    {
                        <tr class="@(l.Skipped is null ? "" : "is-inactive")">
                            <td><a class="ams-link" href="assets/@l.AssetId">@l.AssetNumber</a> @l.AssetName</td>
                            <td>@l.PurchaseCost.ToString("N2")</td>
                            <td>@(l.Skipped is null ? l.Amount.ToString("N2") : "—")</td>
                            <td>@(l.Skipped is null ? l.AccumulatedDepreciation.ToString("N2") : "—")</td>
                            <td>@(l.Skipped is null ? l.NetBookValue.ToString("N2") : "—")</td>
                            <td>@(l.Skipped ?? "")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="ams-form-actions">
                <span class="ams-muted" style="margin-right:auto;">
                    @Postable asset(s) will be posted · @(_preview.Count - Postable) skipped
                </span>
                <button class="ams-btn" @onclick="PostAsync" disabled="@(_busy || Postable == 0)">Post @Postable entry(ies)</button>
            </div>
        }

        <p class="ams-hint">
            Posting writes one entry per asset for the chosen date. Running the same date twice
            changes nothing: the assets that already have an entry are skipped.
            Nothing is ever depreciated below the salvage value.
        </p>
    </section>
}

@* ------------------------------------------------ what was posted *@
<div class="ams-card">
    @if (_rows is null)
    {
        <div class="ams-empty">Loading&hellip;</div>
    }
    else if (_rows.Count == 0)
    {
        <div class="ams-empty">Nothing has been posted yet.</div>
    }
    else
    {
        <table class="ams-table">
            <thead>
                <tr><th>Period</th><th>Asset</th><th>Amount</th><th>Accumulated</th><th>Book value</th><th>Type</th></tr>
            </thead>
            <tbody>
                @foreach (var e in _rows)
                {
                    <tr>
                        <td>@e.PeriodDate.ToString("yyyy-MM-dd")</td>
                        <td><a class="ams-link" href="assets/@e.AssetId">@e.Asset?.AssetNumber</a> @e.Asset?.Name</td>
                        <td>@e.Amount.ToString("N2")</td>
                        <td>@e.AccumulatedDepreciation.ToString("N2")</td>
                        <td>@e.NetBookValue.ToString("N2")</td>
                        <td>@(e.Notes ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>

        <Pager Page="_page" Total="_total" PageChanged="GoToAsync" />
    }
</div>

@code {
    private List<DepreciationEntry>? _rows;
    private List<DepreciationPreviewLine>? _preview;
    private bool _isAdmin;

    private string _period = DepreciationPeriod.Monthly;
    private DateTime _periodEnd = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddDays(-1);
    private bool _busy;
    private int _total;
    private int _page = 1;

    private string? _error;
    private string? _posted;

    private int Postable => _preview?.Count(l => l.Skipped is null) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        try { _isAdmin = await CurrentUser.IsInRoleAsync(AppRoles.Admin); }
        catch (Exception ex) { _error = ex.Message; }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            var result = await Depreciation.GetAllAsync(_page);
            _rows = result.Items;
            _total = result.Total;
            _error = null;
        }
        catch (Exception ex) { _error = ex.Message; }
    }


    private async Task GoToAsync(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private async Task FilterAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    private void ClearPreview()
    {
        _preview = null;
        _posted = null;
    }

    private async Task PreviewAsync()
    {
        _error = null;
        _posted = null;
        _busy = true;

        try { _preview = await Depreciation.PreviewAsync(_period, _periodEnd); }
        catch (Exception ex) { _error = ex.InnerException?.Message ?? ex.Message; }
        finally { _busy = false; }
    }

    private async Task PostAsync()
    {
        _error = null;
        _busy = true;

        try
        {
            var count = await Depreciation.PostAsync(_period, _periodEnd);
            _posted = $"{count} entry(ies) posted for {_periodEnd:yyyy-MM-dd}.";
            _preview = null;
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.InnerException?.Message ?? ex.Message; }
        finally { _busy = false; }
    }
}
