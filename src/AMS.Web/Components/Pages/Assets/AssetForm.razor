@page "/assets/new"
@page "/assets/{Id:int}/edit"
@inject AssetService Assets
@inject CrudService<Category> Categories
@inject CrudService<Brand> Brands
@inject CrudService<AssetStatus> Statuses
@inject CrudService<Supplier> Suppliers
@inject CrudService<Location> Locations
@inject CrudService<Department> Departments
@inject CrudService<Employee> Employees
@inject InvoiceService Invoices
@inject NavigationManager Nav

<PageTitle>@(IsNew ? "Register Asset" : "Edit Asset")</PageTitle>

<div class="ams-page-head">
    <div>
        <h1>@(IsNew ? "Register Asset" : $"Edit {_asset?.AssetNumber}")</h1>
        <div class="sub">@(IsNew ? "Add a new asset to the register" : _asset?.Name)</div>
    </div>
    <button class="ams-btn ghost" @onclick="Cancel">Cancel</button>
</div>

@if (_error is not null)
{
    <div class="ams-alert">@_error</div>
}

@if (_asset is null)
{
    <div class="ams-empty">@(_notFound ? "Asset not found." : "Loading…")</div>
}
else
{
    @* ------------------------------------------------ Basic *@
    <section class="ams-section">
        <h2>Basic information</h2>
        <div class="ams-grid">
            <div class="ams-field">
                <label>Asset number</label>
                @if (!IsNew)
                {
                    <div class="ams-readonly">@_asset.AssetNumber</div>
                }
                else if (_preview is not null)
                {
                    <div class="ams-readonly">@_preview <span class="ams-muted">(generated on save)</span></div>
                }
                else
                {
                    <div class="ams-readonly ams-muted">Choose a category — the number follows from it</div>
                }
            </div>
            <div class="ams-field">
                <label>Name *</label>
                <input @bind="_asset.Name" />
            </div>
            <div class="ams-field">
                <label>Category *</label>
                <select @bind="_asset.CategoryId" @bind:after="UpdatePreviewAsync">
                    <option value="0">— select —</option>
                    @foreach (var c in _categories)
                    {
                        <option value="@c.Id">@c.Name @(string.IsNullOrWhiteSpace(c.NumberingPrefix) ? "" : $"({c.NumberingPrefix})")</option>
                    }
                </select>
                <QuickAddCategory OnAdded="QuickCategoryAddedAsync" />
            </div>
            <div class="ams-field">
                <label>Status *</label>
                <select @bind="_asset.StatusId">
                    <option value="0">— select —</option>
                    @foreach (var s in _statuses)
                    {
                        <option value="@s.Id">@s.Name</option>
                    }
                </select>
                <QuickAdd TItem="AssetStatus" What="condition" OnAdded="StatusAddedAsync" />
            </div>
            <div class="ams-field">
                <label>Brand</label>
                <select @bind="_asset.BrandId">
                    <option value="">— none —</option>
                    @foreach (var b in _brands)
                    {
                        <option value="@b.Id">@b.Name</option>
                    }
                </select>
                <QuickAdd TItem="Brand" What="brand" OnAdded="BrandAddedAsync" />
            </div>
            <div class="ams-field"><label>Model</label><input @bind="_asset.Model" /></div>
            <div class="ams-field"><label>Serial number</label><input @bind="_asset.SerialNumber" /></div>
            <div class="ams-field"><label>Tag / barcode</label><input @bind="_asset.TagOrBarcodeNumber" /></div>
            <div class="ams-field"><label>Legacy asset number</label><input @bind="_asset.LegacyAssetNumber" /></div>
            <div class="ams-field"><label>Condition</label><input @bind="_asset.Condition" /></div>
            <div class="ams-field">
                <label>Part of (parent asset)</label>
                <select @bind="_asset.ParentAssetId">
                    <option value="">— none —</option>
                    @foreach (var a in _parents)
                    {
                        <option value="@a.Id">@a.AssetNumber — @a.Name</option>
                    }
                </select>
            </div>
        </div>
        <div class="ams-field">
            <label>Description</label>
            <textarea rows="2" @bind="_asset.Description"></textarea>
        </div>
    </section>

    @* ------------------------------------------------ Purchase *@
    <section class="ams-section">
        <h2>Purchase</h2>
        <div class="ams-grid">
            <div class="ams-field">
                <label>Supplier</label>
                <select @bind="_asset.SupplierId">
                    <option value="">— none —</option>
                    @foreach (var s in _suppliers)
                    {
                        <option value="@s.Id">@s.Name</option>
                    }
                </select>
                <QuickAdd TItem="Supplier" What="supplier" OnAdded="SupplierAddedAsync" />
            </div>
            <div class="ams-field"><label>Purchase order no.</label><input @bind="_asset.PurchaseOrderNumber" /></div>
            @if (!IsNew)
            {
                <div class="ams-field"><label>Invoice no.</label><input @bind="_asset.InvoiceNumber" /></div>
            }
            <div class="ams-field"><label>Purchase date</label><input type="date" @bind="_asset.PurchaseDate" /></div>
            <div class="ams-field"><label>Purchase cost</label><input type="number" step="0.01" @bind="_asset.PurchaseCost" /></div>
            <div class="ams-field">
                <label>Currency</label>
                <select @bind="_asset.Currency">
                    @foreach (var c in Currencies.All)
                    {
                        <option value="@c">@c</option>
                    }
                </select>
            </div>
            <div class="ams-field"><label>Funding source</label><input @bind="_asset.FundingSource" /></div>
        </div>

        @if (IsNew)
        {
            <div class="ams-field" style="margin-top:6px;">
                <label style="font-weight:400;">
                    <input type="checkbox" style="width:auto;margin-right:6px;" @bind="_createInvoice" />
                    Record a supplier invoice for this asset
                </label>
                <span class="ams-hint">
                    Off by default: an asset can arrive by transfer, donation or from the old register,
                    and those have no invoice. Tick it and the asset is put on one as a line, using the
                    supplier, purchase date and cost above.
                </span>
            </div>

            @if (_createInvoice)
            {
                <div class="ams-grid">
                    <div class="ams-field">
                        <label>Invoice</label>
                        <select @bind="_invoiceId">
                            <option value="">— raise a new one —</option>
                            @foreach (var i in _invoices)
                            {
                                <option value="@i.Id">@i.InvoiceNumber @(i.Supplier is null ? "" : "· " + i.Supplier.Name)</option>
                            }
                        </select>
                    </div>

                    @if (_invoiceId is null)
                    {
                        <div class="ams-field">
                            <label>New invoice number *</label>
                            <input @bind="_asset.InvoiceNumber" placeholder="the number on the supplier's invoice" />
                        </div>
                    }
                </div>
            }
        }

    </section>

    @* ------------------------------------------------ Warranty & insurance *@
    <section class="ams-section">
        <h2>Warranty &amp; insurance</h2>
        <div class="ams-grid">
            <div class="ams-field"><label>Warranty start</label><input type="date" @bind="_asset.WarrantyStart" /></div>
            <div class="ams-field"><label>Warranty end</label><input type="date" @bind="_asset.WarrantyEnd" /></div>
            <div class="ams-field"><label>Insurance policy no.</label><input @bind="_asset.InsurancePolicyNumber" /></div>
            <div class="ams-field"><label>Insurer</label><input @bind="_asset.Insurer" /></div>
            <div class="ams-field"><label>Insured value</label><input type="number" step="0.01" @bind="_asset.InsuredValue" /></div>
            <div class="ams-field"><label>Insurance expiry</label><input type="date" @bind="_asset.InsuranceExpiryDate" /></div>
        </div>
    </section>

    @* ------------------------------------------------ Location & custody *@
    <section class="ams-section">
        <h2>Location &amp; custody</h2>
        @if (IsNew)
        {
            <p class="ams-hint">
                Where the asset is right now. After registration these can only change through transactions
                (Assignment, Transfer, Return). Choosing a custodian registers the asset as <strong>Assigned</strong>;
                otherwise it starts <strong>In store</strong>.
            </p>
            <div class="ams-grid">
                <div class="ams-field">
                    <label>Location</label>
                    <select @bind="_asset.LocationId">
                        <option value="">— none —</option>
                        @foreach (var l in _locations)
                        {
                            <option value="@l.Id">@l.Name</option>
                        }
                    </select>
                    <QuickAdd TItem="Location" What="location" OnAdded="LocationAddedAsync" />
                </div>
                <div class="ams-field">
                    <label>Department</label>
                    <select @bind="_asset.DepartmentId">
                        <option value="">— none —</option>
                        @foreach (var d in _departments)
                        {
                            <option value="@d.Id">@d.Name</option>
                        }
                    </select>
                    <QuickAdd TItem="Department" What="department" OnAdded="DepartmentAddedAsync" />
                </div>
                <div class="ams-field">
                    <label>Custodian</label>
                    <select @bind="_asset.CustodianId">
                        <option value="">— none (in store) —</option>
                        @foreach (var e in _employees)
                        {
                            <option value="@e.Id">@e.EmployeeNumber — @e.Name</option>
                        }
                    </select>
                    <QuickAddEmployee OnAdded="QuickEmployeeAddedAsync" />
                </div>
            </div>
        }
        else
        {
            <p class="ams-hint">These change only through transactions, so the asset's history stays complete.</p>
            <div class="ams-grid">
                <div class="ams-field"><label>Stage</label><div class="ams-readonly"><StageBadge Stage="_asset.LifecycleStage" /></div></div>
                <div class="ams-field"><label>Location</label><div class="ams-readonly">@(_asset.Location?.Name ?? "—")</div></div>
                <div class="ams-field"><label>Department</label><div class="ams-readonly">@(_asset.Department?.Name ?? "—")</div></div>
                <div class="ams-field"><label>Custodian</label><div class="ams-readonly">@(_asset.Custodian?.Name ?? "—")</div></div>
            </div>
        }
    </section>

    @* ------------------------------------------------ Notes *@
    <section class="ams-section">
        <h2>Notes</h2>
        <div class="ams-field">
            <textarea rows="3" @bind="_asset.Notes"></textarea>
        </div>
    </section>

    <div class="ams-form-actions">
        <button class="ams-btn ghost" @onclick="Cancel">Cancel</button>
        <button class="ams-btn" @onclick="SaveAsync" disabled="@_saving">@(IsNew ? "Register asset" : "Save changes")</button>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }

    private bool IsNew => Id is null;

    private Asset? _asset;
    private string? _preview;

    /// <summary>Raising the invoice is a decision, so it is a tick box, never automatic.</summary>
    private bool _createInvoice;
    private int? _invoiceId;
    private List<Invoice> _invoices = new();
    private bool _notFound;
    private bool _saving;
    private string? _error;

    private List<Category> _categories = new();
    private List<Brand> _brands = new();
    private List<AssetStatus> _statuses = new();
    private List<Supplier> _suppliers = new();
    private List<Location> _locations = new();
    private List<Department> _departments = new();
    private List<Employee> _employees = new();
    private List<Asset> _parents = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _categories = await Categories.GetAllAsync();
            if (IsNew) await LoadInvoicesAsync();
            _brands = await Brands.GetAllAsync();
            _statuses = await Statuses.GetAllAsync();
            _suppliers = await Suppliers.GetAllAsync();
            _locations = await Locations.GetAllAsync();
            _departments = await Departments.GetAllAsync();
            _employees = await Employees.GetAllAsync();

            if (IsNew)
            {
                // The drop-down shows EGP from the start, so the model has to agree with it;
                // otherwise an untouched currency box saves nothing at all.
                _asset = new Asset { Currency = Currencies.Default };
                // PageSize 0 = no paging: the "Part of" list needs every asset.
                _parents = (await Assets.SearchAsync(new AssetFilter(PageSize: 0))).Items;
            }
            else
            {
                _asset = await Assets.GetDetailsAsync(Id!.Value);
                _notFound = _asset is null;

                // An asset saved before the currency became a list has none, or has it in
                // another spelling; put it on the list so the box is not silently blank.
                if (_asset is not null) _asset.Currency = Currencies.Normalise(_asset.Currency);
                _parents = (await Assets.SearchAsync(new AssetFilter(PageSize: 0))).Items
                    .Where(a => a.Id != Id)
                    .ToList();
            }
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    // ------------------------------------------------------------------
    // Quick-add: a lookup added here is reloaded and selected straight away,
    // so a missing brand or location never costs you the form you are filling in.
    // ------------------------------------------------------------------

    private async Task StatusAddedAsync(AssetStatus status)
    {
        _statuses = await Statuses.GetAllAsync();
        _asset.StatusId = status.Id;
    }

    private async Task BrandAddedAsync(Brand brand)
    {
        _brands = await Brands.GetAllAsync();
        _asset.BrandId = brand.Id;
    }

    private async Task SupplierAddedAsync(Supplier supplier)
    {
        _suppliers = await Suppliers.GetAllAsync();
        _asset.SupplierId = supplier.Id;
    }

    private async Task LocationAddedAsync(Location location)
    {
        _locations = await Locations.GetAllAsync();
        _asset.LocationId = location.Id;
    }

    private async Task DepartmentAddedAsync(Department department)
    {
        _departments = await Departments.GetAllAsync();
        _asset.DepartmentId = department.Id;
    }

    private async Task UpdatePreviewAsync()
    {
        if (!IsNew || _asset is null) return;

        _preview = _asset.CategoryId == 0 ? null : await Assets.PreviewNextNumberAsync(_asset.CategoryId);
    }

    private async Task LoadInvoicesAsync()
    {
        try { _invoices = (await Invoices.GetAllAsync(false, 1)).Items; }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task SaveAsync()
    {
        if (_asset is null) return;
        _error = null;

        if (string.IsNullOrWhiteSpace(_asset.Name)) { _error = "Name is required."; return; }
        if (_asset.CategoryId == 0) { _error = "Category is required."; return; }
        if (_asset.StatusId == 0) { _error = "Status is required."; return; }
        _saving = true;
        try
        {
            if (IsNew)
            {
                var newId = await Assets.RegisterAsync(_asset);

                // The asset exists first; the invoice line points at it.
                if (_createInvoice)
                {
                    await Invoices.RecordAssetPurchaseAsync(new AssetPurchaseInput(
                        newId, _invoiceId, _asset.InvoiceNumber, _asset.SupplierId,
                        _asset.PurchaseDate, _asset.PurchaseCost, _asset.Currency));
                }

                Nav.NavigateTo($"assets/{newId}");
            }
            else
            {
                await Assets.UpdateDetailsAsync(_asset);
                Nav.NavigateTo($"assets/{_asset.Id}");
            }
        }
        catch (Exception ex)
        {
            _error = ex.InnerException?.Message ?? ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel() => Nav.NavigateTo(IsNew ? "assets" : $"assets/{Id}");

    private async Task QuickCategoryAddedAsync(Category created)
    {
        _categories = await Categories.GetAllAsync();
        _asset.CategoryId = created.Id;

        // The asset number comes from the category prefix, so the preview has to catch up.
        await UpdatePreviewAsync();
    }

    private async Task QuickEmployeeAddedAsync(Employee created)
    {
        _employees = await Employees.GetAllAsync();
        _asset.CustodianId = created.Id;
    }
}
