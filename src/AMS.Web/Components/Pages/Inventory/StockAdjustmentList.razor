@page "/stock-adjustments"

<PageTitle>Stock Adjustments</PageTitle>

<div class="ams-page-head">
    <div>
        <h1>Stock Adjustments</h1>
        <div class="sub">@_total adjustment(s) — how consumable items leave or enter stock outside a delivery</div>
    </div>
    <button class="ams-btn" @onclick="OpenNew">+ Adjust Stock</button>
</div>

@if (_error is not null)
{
    <div class="ams-alert">@_error</div>
}

<div class="ams-card">
    @if (_rows is null)
    {
        <div class="ams-empty">Loading&hellip;</div>
    }
    else if (_rows.Count == 0)
    {
        <div class="ams-empty">No adjustments yet.</div>
    }
    else
    {
        <table class="ams-table">
            <thead>
                <tr><th>Date</th><th>Store</th><th>Item</th><th>Direction</th><th>Quantity</th><th>Reason</th><th>Recorded by</th></tr>
            </thead>
            <tbody>
                @foreach (var a in _rows)
                {
                    <tr>
                        <td>@a.Date?.ToString("yyyy-MM-dd")</td>
                        <td>@(a.Store?.Name ?? "—")</td>
                        <td>@(a.Item?.Name ?? "—")</td>
                        <td>@a.AdjustmentType</td>
                        <td>@a.Quantity?.ToString("N2")</td>
                        <td>@a.Reason</td>
                        <td><UserName Id="a.CreatedById" Names="_userNames" /></td>
                    </tr>
                }
            </tbody>
        </table>

        <Pager Page="_page" Total="_total" PageChanged="GoToAsync" />
    }
</div>

<ModalForm Visible="_open" Error="@_error" Title="Adjust stock" OnSave="SaveAsync" OnCancel="Close">
    <div class="ams-grid">
        <div class="ams-field">
            <label>Store *</label>
            @if (_stores.Count == 0)
            {
                <div class="ams-readonly">No stores yet — <a class="ams-link" href="master/stores">add them in Stores</a>.</div>
            }
            else
            {
                <select @bind="_storeId" @bind:after="ShowBalanceAsync">
                    <option value="0">— select —</option>
                    @foreach (var s in _stores)
                    {
                        <option value="@s.Id">@s.Name</option>
                    }
                </select>
                <QuickAdd TItem="Store" What="store" OnAdded="QuickStoreAddedAsync" />
            }
        </div>

        <div class="ams-field">
            <label>Item *</label>
            @if (_items.Count == 0)
            {
                <div class="ams-readonly">No items yet — <a class="ams-link" href="master/items">add them in Items</a>.</div>
            }
            else
            {
                <select @bind="_itemId" @bind:after="ShowBalanceAsync">
                    <option value="0">— select —</option>
                    @foreach (var i in _items)
                    {
                        <option value="@i.Id">@i.Name</option>
                    }
                </select>
                <QuickAddItem OnAdded="QuickItemAddedAsync" />
            }
        </div>

        <div class="ams-field">
            <label>In stock now</label>
            <div class="ams-readonly">@_current.ToString("N2")</div>
        </div>

        <div class="ams-field">
            <label>Direction *</label>
            <select @bind="_direction">
                <option value="@StockDirection.Decrease">Decrease (consumed, damaged, count correction)</option>
                <option value="@StockDirection.Increase">Increase (found again, count correction)</option>
            </select>
        </div>

        <div class="ams-field">
            <label>Quantity *</label>
            <input type="number" step="0.01" @bind="_quantity" />
        </div>

        <div class="ams-field">
            <label>Date *</label>
            <input type="date" @bind="_date" />
        </div>
    </div>

    <div class="ams-field">
        <label>Reason *</label>
        <textarea rows="2" @bind="_reason"></textarea>
    </div>

    <p class="ams-hint">Applied at once, with no approval. Stock can never go below zero.</p>
</ModalForm>
