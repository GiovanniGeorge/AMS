@page "/maintenance-plans"
@inject IMaintenancePlanService Plans
@inject IAssetService Assets
@inject ICrudService<Category> Categories
@inject ICrudService<User> Users
@inject NavigationManager Nav

<PageTitle>Preventive Maintenance</PageTitle>

<div class="ams-page-head">
    <div>
        <h1>Preventive Maintenance</h1>
        <div class="sub">@(_rows?.Count ?? 0) plan(s) — nothing happens by itself: what is due is listed and you open the work order</div>
    </div>
    <button class="ams-btn" @onclick="OpenNew">+ New Plan</button>
</div>

@if (_error is not null)
{
    <div class="ams-alert">@_error</div>
}

@* ------------------------------------------------ due now *@
<section class="ams-section">
    <h2>Due now (@_due.Count)</h2>

    @if (_due.Count == 0)
    {
        <p class="ams-hint">Nothing is due. An asset that is already under maintenance is not listed.</p>
    }
    else
    {
        <table class="ams-table">
            <thead>
                <tr><th>Due on</th><th>Asset</th><th>Plan</th><th>Every</th><th>Last done</th><th class="actions">Action</th></tr>
            </thead>
            <tbody>
                @foreach (var d in _due)
                {
                    <tr>
                        <td>@d.DueOn.ToString("yyyy-MM-dd")</td>
                        <td><a class="ams-link" href="assets/@d.AssetId">@d.AssetNumber</a> @d.AssetName</td>
                        <td>@d.PlanName</td>
                        <td>@d.Frequency</td>
                        <td>@(d.LastDone?.ToString("yyyy-MM-dd") ?? "never")</td>
                        <td class="actions">
                            <button class="ams-btn link" @onclick="() => OpenWorkOrderAsync(d)">Open work order</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@* ------------------------------------------------ the plans *@
<div class="ams-card">
    @if (_rows is null)
    {
        <div class="ams-empty">Loading&hellip;</div>
    }
    else if (_rows.Count == 0)
    {
        <div class="ams-empty">No plans yet.</div>
    }
    else
    {
        <table class="ams-table">
            <thead>
                <tr>
                    <th>Name</th><th>Covers</th><th>Every</th><th>Schedule notes</th>
                    <th>Usage threshold</th><th>From</th><th>To</th><th>Created by</th><th class="actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in _rows)
                {
                    <tr>
                        <td>@p.Name</td>
                        <td>
                            @if (p.Asset is not null)
                            {
                                <a class="ams-link" href="assets/@p.AssetId">@p.Asset.AssetNumber</a>
                                <span> @p.Asset.Name</span>
                            }
                            else if (p.Category is not null)
                            {
                                <span>Category: @p.Category.Name</span>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>
                        <td>@(p.Frequency ?? "—")</td>
                        <td>@(p.RepeatSchedule ?? "—")</td>
                        <td>@(p.UsageThreshold?.ToString("N2") ?? "—")</td>
                        <td>@p.StartDate?.ToString("yyyy-MM-dd")</td>
                        <td>@p.EndDate?.ToString("yyyy-MM-dd")</td>
                        <td><UserName Id="p.CreatedById" Names="_userNames" /></td>
                        <td class="actions">
                            <button class="ams-btn link" @onclick="() => OpenEdit(p)">Edit</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<ModalForm Visible="_open" Title="@(_editId is null ? "New plan" : "Edit plan")" OnSave="SaveAsync" OnCancel="Close">
    <div class="ams-grid">
        <div class="ams-field">
            <label>Name *</label>
            <input @bind="_name" placeholder="Quarterly printer service" />
        </div>

        <div class="ams-field">
            <label>Every *</label>
            <select @bind="_frequency">
                @foreach (var f in PlanFrequency.All)
                {
                    <option value="@f">@f</option>
                }
            </select>
        </div>

        <div class="ams-field">
            <label>One asset</label>
            <select @bind="_assetId" @bind:after="OnAssetChosen">
                <option value="">— none —</option>
                @foreach (var a in _assets)
                {
                    <option value="@a.Id">@a.AssetNumber — @a.Name</option>
                }
            </select>
        </div>

        <div class="ams-field">
            <label>…or a whole category</label>
            <select @bind="_categoryId" @bind:after="OnCategoryChosen">
                <option value="">— none —</option>
                @foreach (var c in _categories)
                {
                    <option value="@c.Id">@c.Name</option>
                }
            </select>
        </div>

        <div class="ams-field">
            <label>Usage threshold</label>
            <input type="number" step="0.01" @bind="_usageThreshold" placeholder="hours / km" />
        </div>

        <div class="ams-field">
            <label>Start date</label>
            <input type="date" @bind="_startDate" />
        </div>

        <div class="ams-field">
            <label>End date</label>
            <input type="date" @bind="_endDate" />
        </div>
    </div>

    <div class="ams-field">
        <label>Schedule notes</label>
        <input @bind="_scheduleNotes" placeholder="e.g. first week of the quarter, outside working hours" />
    </div>

    <p class="ams-hint">
        Choose an asset <strong>or</strong> a category, not both. The next date is the last work order
        this plan opened plus one cycle; a plan that never ran is due from its start date.
        The usage threshold is a note for the technician — AMS does not read meters.
    </p>
</ModalForm>

@code {
    private List<PreventiveMaintenancePlan>? _rows;
    private List<DuePlanItem> _due = new();
    private List<Asset> _assets = new();
    private List<Category> _categories = new();
    private Dictionary<int, string> _userNames = new();

    private bool _open;
    private int? _editId;
    private string? _name;
    private int? _assetId;
    private int? _categoryId;
    private string _frequency = PlanFrequency.Monthly;
    private string? _scheduleNotes;
    private decimal? _usageThreshold;
    private DateTime? _startDate = DateTime.Today;
    private DateTime? _endDate;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _assets = (await Assets.SearchAsync(new AssetFilter(PageSize: 0))).Items;
            _categories = await Categories.GetAllAsync();
            _userNames = (await Users.GetAllAsync(true)).ToDictionary(u => u.Id, u => u.Username);
        }
        catch (Exception ex) { _error = ex.Message; }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _rows = await Plans.GetAllAsync();
            _due = await Plans.GetDueAsync();
            _error = null;
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private void OpenNew()
    {
        _editId = null;
        _name = null;
        _assetId = null;
        _categoryId = null;
        _frequency = PlanFrequency.Monthly;
        _scheduleNotes = null;
        _usageThreshold = null;
        _startDate = DateTime.Today;
        _endDate = null;
        _error = null;
        _open = true;
    }

    private void OpenEdit(PreventiveMaintenancePlan plan)
    {
        _editId = plan.Id;
        _name = plan.Name;
        _assetId = plan.AssetId;
        _categoryId = plan.CategoryId;
        _frequency = plan.Frequency ?? PlanFrequency.Monthly;
        _scheduleNotes = plan.RepeatSchedule;
        _usageThreshold = plan.UsageThreshold;
        _startDate = plan.StartDate;
        _endDate = plan.EndDate;
        _error = null;
        _open = true;
    }

    private void Close() => _open = false;

    // An asset and a category together would be two different scopes in one plan.
    private void OnAssetChosen() { if (_assetId is not null) _categoryId = null; }
    private void OnCategoryChosen() { if (_categoryId is not null) _assetId = null; }

    private async Task SaveAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_name)) { _error = "The name is required."; return; }
        if (_assetId is null && _categoryId is null) { _error = "Choose an asset or a category."; return; }

        try
        {
            var input = new MaintenancePlanInput(
                _name!, _assetId, _categoryId, _frequency, _scheduleNotes, _usageThreshold, _startDate, _endDate);

            if (_editId is int id) await Plans.UpdateAsync(id, input);
            else await Plans.CreateAsync(input);

            _open = false;
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.InnerException?.Message ?? ex.Message; }
    }

    private async Task OpenWorkOrderAsync(DuePlanItem item)
    {
        _error = null;
        try
        {
            await Plans.OpenWorkOrderAsync(item.PlanId, item.AssetId);
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.InnerException?.Message ?? ex.Message; }
    }
}
