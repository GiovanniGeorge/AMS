@page "/incidents"
@inject IIncidentService Incidents
@inject ICrudService<User> Users
@inject ICurrentUserService CurrentUser

<PageTitle>Incidents</PageTitle>

<div class="ams-page-head">
    <div>
        <h1>Incidents</h1>
        <div class="sub">@_total incident(s) — damage, malfunction, missing or stolen assets</div>
    </div>
    <button class="ams-btn" @onclick="OpenNew">+ Report Incident</button>
</div>

@if (_error is not null)
{
    <div class="ams-alert">@_error</div>
}

<div class="ams-card">
    @if (_rows is null)
    {
        <div class="ams-empty">Loading&hellip;</div>
    }
    else if (_rows.Count == 0)
    {
        <div class="ams-empty">No incidents.</div>
    }
    else
    {
        <table class="ams-table">
            <thead>
                <tr>
                    <th>Date</th><th>Asset</th><th>Type</th><th>Description</th>
                    <th>Last stage</th><th>Last custodian</th><th>Status</th>
                    <th>Reported by</th><th>Decision note</th><th class="actions">Decision</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var i in _rows)
                {
                    <tr>
                        <td>@i.Date?.ToString("yyyy-MM-dd")</td>
                        <td><a class="ams-link" href="assets/@i.AssetId">@i.Asset?.AssetNumber</a> @i.Asset?.Name</td>
                        <td>@(i.IncidentType?.ToString() ?? "—")</td>
                        <td>@(i.Description ?? "—")</td>
                        <td>@(i.LastStage is LifecycleStage s ? Stage(s) : "—")</td>
                        <td>@(i.LastCustodian?.Name ?? "—")</td>
                        <td>@i.Status</td>
                        <td><UserName Id="i.CreatedById" Names="_userNames" /></td>
                        <td class="ams-reason">@i.Approval?.Comments</td>
                        <td class="actions">
                            @if (i.Status == IncidentStatus.Pending && _isApprover)
                            {
                                <button class="ams-btn link" @onclick="() => ToWorkOrderAsync(i.Id)">To work order</button>
                                <button class="ams-btn link" @onclick="() => ToDisposalAsync(i.Id)">To disposal</button>
                                <button class="ams-btn link danger" @onclick="() => OpenReject(i.Id)">Reject</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <Pager Page="_page" Total="_total" PageChanged="GoToAsync" />
    }
</div>

<ModalForm Visible="_open" Title="Report incident" OnSave="SaveAsync" OnCancel="Close">
    <div class="ams-grid">
        <div class="ams-field">
            <label>Asset *</label>
            @if (_assets.Count == 0)
            {
                <div class="ams-readonly">No asset is available — only active assets that are not disposed of.</div>
            }
            else
            {
                <select @bind="_assetId" @bind:after="OnAssetChanged">
                    <option value="0">— select —</option>
                    @foreach (var a in _assets)
                    {
                        <option value="@a.Id">@a.AssetNumber — @a.Name</option>
                    }
                </select>
            }
        </div>

        <div class="ams-field">
            <label>Currently with</label>
            <div class="ams-readonly">@_custodian</div>
        </div>

        <div class="ams-field">
            <label>Type *</label>
            <select @bind="_type">
                <option value="@IncidentType.Damaged">Damaged</option>
                <option value="@IncidentType.Malfunction">Malfunction</option>
                <option value="@IncidentType.Missing">Missing</option>
                <option value="@IncidentType.Stolen">Stolen</option>
            </select>
        </div>

        <div class="ams-field">
            <label>Date *</label>
            <input type="date" @bind="_date" />
        </div>
    </div>

    <div class="ams-field">
        <label>Description</label>
        <textarea rows="3" @bind="_description"></textarea>
    </div>

    <p class="ams-hint">
        @if (_type == IncidentType.Damaged || _type == IncidentType.Malfunction)
        {
            <span>The approver decides whether the asset goes to a <strong>work order</strong> or to <strong>disposal</strong>.</span>
        }
        else
        {
            <span>
                Missing and stolen assets need no approval here: a <strong>disposal request</strong> is created
                right away, and the approver sees the asset's last stage and last custodian.
            </span>
        }
    </p>
</ModalForm>

<ModalForm Visible="_rejectId is not null" Title="Reject incident" OnSave="RejectAsync" OnCancel="CloseReject">
    <div class="ams-field">
        <label>Reason * <span class="ams-muted">(the person who reported it will see it)</span></label>
        <textarea rows="3" @bind="_reason"></textarea>
    </div>
</ModalForm>

@code {
    [SupplyParameterFromQuery] public int? AssetId { get; set; }

    private List<Incident>? _rows;
    private List<Asset> _assets = new();
    private Dictionary<int, string> _userNames = new();
    private bool _isApprover;
    private int _total;
    private int _page = 1;


    private bool _open;
    private int _assetId;
    private string _custodian = "—";
    private IncidentType _type = IncidentType.Damaged;
    private DateTime _date = DateTime.Today;
    private string? _description;

    private int? _rejectId;
    private string _reason = string.Empty;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _userNames = (await Users.GetAllAsync(true)).ToDictionary(u => u.Id, u => u.Username);
            _isApprover = await CurrentUser.IsInRoleAsync(AppRoles.Admin);
        }
        catch (Exception ex) { _error = ex.Message; }

        await LoadAsync();

        if (AssetId is int id)
        {
            OpenNew();
            if (_assets.Any(a => a.Id == id))
            {
                _assetId = id;
                OnAssetChanged();
            }
            else
            {
                _error = "No incident can be reported on that asset.";
            }
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            var result = await Incidents.GetAllAsync(null, _page);
            _rows = result.Items;
            _total = result.Total;
            _assets = await Incidents.GetReportableAssetsAsync();
            _error = null;
        }
        catch (Exception ex) { _error = ex.Message; }
    }


    private async Task GoToAsync(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private async Task FilterAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    private void OpenNew()
    {
        _assetId = 0;
        _custodian = "—";
        _type = IncidentType.Damaged;
        _date = DateTime.Today;
        _description = null;
        _error = null;
        _open = true;
    }

    private void Close() => _open = false;

    private void OnAssetChanged()
    {
        var asset = _assets.FirstOrDefault(a => a.Id == _assetId);
        _custodian = asset?.Custodian?.Name ?? "Store";
    }

    private async Task SaveAsync()
    {
        _error = null;
        if (_assetId == 0) { _error = "Asset is required."; return; }
        if (_date == default) { _error = "The date is required."; return; }

        try
        {
            await Incidents.CreateAsync(new IncidentInput(_assetId, _type, _description, _date));
            _open = false;
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.InnerException?.Message ?? ex.Message; }
    }

    private async Task ToWorkOrderAsync(int id)
    {
        _error = null;
        try
        {
            await Incidents.SendToWorkOrderAsync(id);
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.InnerException?.Message ?? ex.Message; }
    }

    private async Task ToDisposalAsync(int id)
    {
        _error = null;
        try
        {
            await Incidents.SendToDisposalAsync(id);
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.InnerException?.Message ?? ex.Message; }
    }

    private void OpenReject(int id)
    {
        _rejectId = id;
        _reason = string.Empty;
        _error = null;
    }

    private void CloseReject() => _rejectId = null;

    private async Task RejectAsync()
    {
        if (_rejectId is null) return;
        if (string.IsNullOrWhiteSpace(_reason)) { _error = "A rejection reason is required."; return; }

        try
        {
            await Incidents.RejectAsync(_rejectId.Value, _reason);
            _rejectId = null;
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.InnerException?.Message ?? ex.Message; }
    }

    private static string Stage(LifecycleStage stage) => stage switch
    {
        LifecycleStage.InStore => "In store",
        LifecycleStage.Assigned => "Assigned",
        LifecycleStage.InTransit => "In transit",
        LifecycleStage.UnderMaintenance => "Under maintenance",
        LifecycleStage.Disposed => "Disposed",
        _ => stage.ToString()
    };
}
