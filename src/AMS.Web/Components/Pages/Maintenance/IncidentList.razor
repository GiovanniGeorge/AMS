@page "/incidents"

<PageTitle>Incidents</PageTitle>

<div class="ams-page-head">
    <div>
        <h1>Incidents</h1>
        <div class="sub">@_total incident(s) — damage, malfunction, missing or stolen assets</div>
    </div>
    <button class="ams-btn" @onclick="OpenNew">+ Report Incident</button>
</div>

@if (_error is not null)
{
    <div class="ams-alert">@_error</div>
}

<div class="ams-card">
    @if (_rows is null)
    {
        <div class="ams-empty">Loading&hellip;</div>
    }
    else if (_rows.Count == 0)
    {
        <div class="ams-empty">No incidents.</div>
    }
    else
    {
        <table class="ams-table">
            <thead>
                <tr>
                    <th>Date</th><th>Asset</th><th>Type</th><th>Description</th>
                    <th>Last stage</th><th>Last custodian</th><th>Status</th>
                    <th>Reported by</th><th>Decision note</th><th class="actions">Decision</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var i in _rows)
                {
                    <tr>
                        <td>@i.Date?.ToString("yyyy-MM-dd")</td>
                        <td><a class="ams-link" href="assets/@i.AssetId">@i.Asset?.AssetNumber</a> @i.Asset?.Name</td>
                        <td>@(i.IncidentType?.ToString() ?? "—")</td>
                        <td>@(i.Description ?? "—")</td>
                        <td>@(i.LastStage is LifecycleStage s ? s.Label() : "—")</td>
                        <td>@(i.LastCustodian?.Name ?? "—")</td>
                        <td>@i.Status</td>
                        <td><UserName Id="i.CreatedById" Names="_userNames" /></td>
                        <td class="ams-reason">@i.Approval?.Comments</td>
                        <td class="actions">
                            @if (i.Status == IncidentStatus.Pending && _isApprover)
                            {
                                <button class="ams-btn link" @onclick="() => ToWorkOrderAsync(i.Id)">To work order</button>
                                <button class="ams-btn link" @onclick="() => ToDisposalAsync(i.Id)">To disposal</button>
                                <button class="ams-btn link danger" @onclick="() => OpenReject(i.Id)">Reject</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <Pager Page="_page" Total="_total" PageChanged="GoToAsync" />
    }
</div>

<ModalForm Visible="_open" Error="@_error" Title="Report incident" OnSave="SaveAsync" OnCancel="Close">
    <div class="ams-grid">
        <div class="ams-field">
            <label>Asset *</label>
            @if (_assets.Count == 0)
            {
                <div class="ams-readonly">No asset is available — only active assets that are not disposed of.</div>
            }
            else
            {
                <select @bind="_assetId" @bind:after="OnAssetChanged">
                    <option value="0">— select —</option>
                    @foreach (var a in _assets)
                    {
                        <option value="@a.Id">@a.AssetNumber — @a.Name</option>
                    }
                </select>
            }
        </div>

        <div class="ams-field">
            <label>Currently with</label>
            <div class="ams-readonly">@_custodian</div>
        </div>

        <div class="ams-field">
            <label>Type *</label>
            <select @bind="_type">
                <option value="@IncidentType.Damaged">Damaged</option>
                <option value="@IncidentType.Malfunction">Malfunction</option>
                <option value="@IncidentType.Missing">Missing</option>
                <option value="@IncidentType.Stolen">Stolen</option>
            </select>
        </div>

        <div class="ams-field">
            <label>Date *</label>
            <input type="date" @bind="_date" />
        </div>
    </div>

    <div class="ams-field">
        <label>Description</label>
        <textarea rows="3" @bind="_description"></textarea>
    </div>

    <p class="ams-hint">
        @if (_type == IncidentType.Damaged || _type == IncidentType.Malfunction)
        {
            <span>The approver decides whether the asset goes to a <strong>work order</strong> or to <strong>disposal</strong>.</span>
        }
        else
        {
            <span>
                Missing and stolen assets need no approval here: a <strong>disposal request</strong> is created
                right away, and the approver sees the asset's last stage and last custodian.
            </span>
        }
    </p>
</ModalForm>

<ModalForm Visible="_rejectId is not null" Error="@_error" Title="Reject incident" OnSave="RejectAsync" OnCancel="CloseReject">
    <div class="ams-field">
        <label>Reason * <span class="ams-muted">(the person who reported it will see it)</span></label>
        <textarea rows="3" @bind="_reason"></textarea>
    </div>
</ModalForm>
